# ========================================
# SyncFlow — Environment Variables
# ========================================
# Copie este arquivo para .env e preencha os valores

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5492/postgres"

# --- Redis (Upstash Serverless) ---
UPSTASH_REDIS_URL="rediss://default:[PASSWORD]@[ENDPOINT].upstash.io:6379"

# --- Clerk Authentication ---
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Asaas Payment Gateway (PIX + Cartão) ---
ASAAS_API_KEY="$aact_..."
ASAAS_WEBHOOK_TOKEN="your_webhook_verification_token"
ASAAS_ENVIRONMENT="sandbox"
# Use "production" para ambiente de produção

# --- Resend Email ---
RESEND_API_KEY="re_..."

# --- Application ---
NODE_ENV="development"
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:4321"
