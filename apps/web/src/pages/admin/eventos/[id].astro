---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import { marked } from 'marked';
import { sanitizeGoogleMapsEmbedUrl, sanitizeYouTubeEmbedUrl } from '@syncflow/shared';

const genderMap: Record<string, string> = {
  'MALE': 'Masculino',
  'FEMALE': 'Feminino',
  'OPEN': 'Misto'
};

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

const user = await prisma.user.findUnique({
  where: { id: userId },
});

if (!user || user.role !== 'ADMIN') {
  await prisma.$disconnect();
  return Astro.redirect('/painel-organizador');
}

const { id } = Astro.params;

if (!id) {
  await prisma.$disconnect();
  return Astro.redirect('/admin/dashboard');
}

const event = await prisma.event.findUnique({
  where: { id },
  include: {
    tenant: true,
    categories: true,
    batches: true,
  }
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/admin/dashboard');
}

const trailerEmbedUrl = sanitizeYouTubeEmbedUrl(event.trailerUrl);
const mapsEmbedUrl = sanitizeGoogleMapsEmbedUrl(event.locationUrl);
---

<BaseLayout title={`Moderação: ${event.title}`}>
  <!-- Cabeçalho HUD -->
  <section class="bg-surface border-b border-ink-muted/20 py-8 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-start font-mono text-xs tracking-widest text-ink-muted gap-2">
      <a href="/admin/dashboard" class="hover:text-accent transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Voltar para Painel Geral
      </a>
      <div class="flex items-center gap-4">
        <span class="text-accent font-bold">MODERAÇÃO DE EVENTOS</span>
        <span class="text-ink-muted">|</span>
        <span class="text-ink-muted font-semibold">REVISÃO DETALHADA</span>
      </div>
      <h1 class="font-heading text-3xl font-extrabold uppercase text-ink tracking-wider mt-2">
        {event.title}
      </h1>
      <div class="text-xs uppercase text-ink-muted mt-1">
        Organização: <span class="text-ink font-bold">{event.tenant.name}</span>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full font-mono text-xs">
    <div class="bg-surface-alt border border-ink-muted/20 shadow-sm p-8 space-y-8 relative">
      <div class="absolute top-0 right-0 w-12 h-12 border-t border-r border-ink-muted/30 pointer-events-none"></div>

      <div class="flex items-center justify-between border-b border-ink-muted/20 pb-4">
        <h2 class="font-heading text-xl font-bold text-ink uppercase tracking-wider">
          Dados do Evento
        </h2>
        <div class="flex items-center gap-3">
          <a
            href={`/painel-organizador/eventos/editar?id=${event.id}`}
            class="bg-accent/10 border border-accent/40 text-accent hover:bg-accent hover:text-black text-xs uppercase px-4 py-2 font-extrabold tracking-wider transition-colors inline-flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Editar Evento
          </a>
          {event.status === 'DRAFT' && (
            <span class="bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-400 text-xs uppercase px-3.5 py-1.5 font-bold tracking-wider">
              Aguardando Aprovação
            </span>
          )}
          {event.status === 'PUBLISHED' && (
            <span class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs uppercase px-3.5 py-1.5 font-bold tracking-wider">
              Publicado
            </span>
          )}
          {event.status === 'REJECTED' && (
            <span class="bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-xs uppercase px-3.5 py-1.5 font-bold tracking-wider">
              Reprovado
            </span>
          )}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <div class="text-xs text-ink-muted uppercase tracking-wider mb-1 font-semibold">Modalidade</div>
            <div class="text-ink uppercase font-bold bg-surface border border-ink-muted/20 px-4 py-3">
              {event.eventType}
            </div>
          </div>
          <div>
            <div class="text-xs text-ink-muted uppercase tracking-wider mb-1 font-semibold">Data & Horário</div>
            <div class="text-ink bg-surface border border-ink-muted/20 px-4 py-3">
              {new Date(event.date).toLocaleString('pt-BR')}
            </div>
          </div>
          <div>
            <div class="text-xs text-ink-muted uppercase tracking-wider mb-1 font-semibold">Limite Geral de Vagas</div>
            <div class="text-ink bg-surface border border-ink-muted/20 px-4 py-3">
              {event.availableSlots} vagas
            </div>
          </div>
          <div>
            <div class="text-xs text-ink-muted uppercase tracking-wider mb-1 font-semibold">Localização</div>
            <div class="text-ink bg-surface border border-ink-muted/20 px-4 py-3 truncate" title={event.location || 'Não informado'}>
              {event.location || 'NÃO INFORMADO'}
            </div>
            {mapsEmbedUrl && (
              <iframe 
                src={mapsEmbedUrl} 
                class="w-full h-64 mt-2 border border-ink-muted/20 grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title={`Mapa de localização para ${event.title}`}
              ></iframe>
            )}
          </div>
        </div>

        <div class="space-y-4">
          <div class="text-xs text-ink-muted uppercase tracking-wider mb-1 font-semibold">Preview de Mídia</div>
          <div class="bg-surface border border-ink-muted/20 p-4 h-full flex flex-col items-center justify-center gap-4">
            {event.logoUrl && (
              <img src={event.logoUrl} alt="Logo" class="w-16 h-16 object-cover rounded-full border border-ink-muted/30" />
            )}
            {event.bannerUrl ? (
              <img src={event.bannerUrl} alt="Banner" class="w-full h-32 object-cover border border-ink-muted/30" />
            ) : (
              <div class="w-full h-32 bg-surface-alt border border-ink-muted/20 flex items-center justify-center text-ink-muted">Sem Banner</div>
            )}
            {trailerEmbedUrl && (
              <div class="w-full mt-4">
                <div class="text-xs text-ink-muted uppercase tracking-wider mb-2 text-center font-semibold">Trailer Promocional</div>
                <div class="aspect-w-16 aspect-h-9 relative w-full h-0 pb-[56.25%] border border-ink-muted/20">
                  <iframe 
                    src={trailerEmbedUrl} 
                    title="YouTube video player" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    class="absolute top-0 left-0 w-full h-full grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
                  ></iframe>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <div class="border-t border-ink-muted/20 pt-6 mb-6">
        <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider mb-4">
          Informações Básicas / Descrição
        </h3>
        <div class="bg-surface border border-ink-muted/20 p-4 text-ink font-sans text-xs whitespace-pre-wrap max-h-48 overflow-y-auto">
          {event.description || 'SEM DESCRIÇÃO INFORMADA'}
        </div>
      </div>

      <div class="border-t border-ink-muted/20 pt-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider">
            Regulamento
          </h3>
          <button id="toggle-markdown" class="text-xs uppercase text-ink-muted hover:text-ink border border-ink-muted/30 hover:border-ink-muted px-3 py-1.5 transition-colors cursor-pointer font-bold">
            Ver em Texto Original
          </button>
        </div>
        
        <div id="contract-html" class="bg-surface border border-ink-muted/20 p-4 text-ink font-sans text-xs max-h-64 overflow-y-auto markdown-body space-y-4">
          <Fragment set:html={event.contractText ? marked.parse(event.contractText) : 'SEM TEXTO DE REGULAMENTO'} />
        </div>

        <div id="contract-text" class="hidden bg-surface border border-ink-muted/20 p-4 text-ink font-sans text-xs whitespace-pre-wrap max-h-64 overflow-y-auto">
          {event.contractText || 'SEM TEXTO DE REGULAMENTO'}
        </div>
        {event.contractPdf && (
          <div class="mt-4">
            <a href={event.contractPdf} target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline uppercase text-xs font-bold inline-flex items-center gap-1.5">
              Visualizar PDF do Regulamento
            </a>
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-ink-muted/20 pt-6">
        <div>
          <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider mb-4">
            Categorias
          </h3>
          <ul class="space-y-2">
            {event.categories.map((cat: any) => (
              <li class="bg-surface border border-ink-muted/20 px-4 py-3 flex items-center justify-between">
                <span class="text-ink uppercase font-bold text-xs">{cat.name}</span>
                <span class="text-ink-muted text-xs">{genderMap[cat.gender] || cat.gender} — {cat.availableSlots} vagas</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider mb-4">
            Lotes
          </h3>
          <ul class="space-y-2">
            {event.batches.map((bat: any) => (
              <li class="bg-surface border border-ink-muted/20 px-4 py-3 flex items-center justify-between">
                <span class="text-ink uppercase font-bold text-xs">{bat.name}</span>
                <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs">
                  {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(bat.price))}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="border-t border-ink-muted/20 pt-8 mt-8 flex flex-col md:flex-row items-center justify-between gap-4">
        {event.status === 'DRAFT' ? (
          <>
            <button
              onclick={`reprovarEvento('${event.id}')`}
              class="w-full md:w-auto border border-red-500/50 hover:bg-red-500/10 text-red-500 dark:text-red-400 text-xs uppercase px-8 py-4 font-extrabold tracking-widest transition-colors cursor-pointer text-center"
            >
              Reprovar Evento
            </button>
            <button
              onclick={`aprovarEvento('${event.id}')`}
              class="w-full md:w-auto bg-emerald-500 hover:bg-emerald-600 text-black text-xs uppercase px-12 py-4 font-extrabold tracking-widest transition-colors cursor-pointer text-center"
            >
              Aprovar & Publicar
            </button>
          </>
        ) : (
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 w-full">
            <span class="text-ink-muted text-xs uppercase font-medium">
              Status atual: <span class="text-ink font-bold">{event.status}</span>. O Super Admin pode editar os dados do evento.
            </span>
            <a
              href={`/painel-organizador/eventos/editar?id=${event.id}`}
              class="border border-ink-muted/40 hover:border-accent hover:text-accent text-ink text-xs uppercase px-8 py-3.5 font-extrabold tracking-widest transition-colors text-center inline-flex items-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              Editar Informações do Evento
            </a>
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- Scripts de Moderação -->
  <script is:inline>
    function initMarkdownToggle() {
      const toggleBtn = document.getElementById('toggle-markdown');
      const htmlView = document.getElementById('contract-html');
      const textView = document.getElementById('contract-text');
      
      if (!toggleBtn || toggleBtn.dataset.init) return;
      toggleBtn.dataset.init = 'true';

      let isHtml = true;
      toggleBtn.addEventListener('click', () => {
        isHtml = !isHtml;
        if (isHtml) {
          htmlView.classList.remove('hidden');
          textView.classList.add('hidden');
          toggleBtn.textContent = 'Ver em Texto Original';
        } else {
          htmlView.classList.add('hidden');
          textView.classList.remove('hidden');
          toggleBtn.textContent = 'Ver em Markdown';
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initMarkdownToggle);
    document.addEventListener('astro:page-load', initMarkdownToggle);
    setTimeout(initMarkdownToggle, 100);

    window.isSubmitting = false;

    window.aprovarEvento = async function(eventId) {
      if (window.isSubmitting) return;
      if (!await window.cyberConfirm('Deseja realmente aprovar este evento para publicação?')) return;
      
      window.isSubmitting = true;
      try {
        const response = await fetch('/api/admin/eventos/aprovar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ eventId })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao aprovar evento.');
        }

        await window.cyberAlert('Evento aprovado com sucesso!');
        window.location.href = '/admin/dashboard';
      } catch (err) {
        window.isSubmitting = false;
        await window.cyberAlert(err.message, 'ERRO_SISTEMA', 'error');
        if (err.message.includes('já foi moderado') || err.message.includes('Acesso negado')) {
          window.location.href = '/admin/dashboard';
        }
      }
    };

    window.reprovarEvento = async function(eventId) {
      if (window.isSubmitting) return;
      const reason = await window.cyberPrompt('Qual o motivo da reprovação? (O organizador verá esta mensagem)');
      if (!reason) return;
      
      window.isSubmitting = true;
      try {
        const response = await fetch('/api/admin/eventos/reprovar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ eventId, reason })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao reprovar evento.');
        }

        await window.cyberAlert('Evento reprovado!');
        window.location.href = '/admin/dashboard';
      } catch (err) {
        window.isSubmitting = false;
        await window.cyberAlert(err.message, 'SYSTEM_ERROR', 'error');
      }
    };
  </script>
</BaseLayout>
