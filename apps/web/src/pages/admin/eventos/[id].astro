---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import { marked } from 'marked';

const genderMap: Record<string, string> = {
  'MALE': 'Masculino',
  'FEMALE': 'Feminino',
  'OPEN': 'Misto'
};

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

const user = await prisma.user.findUnique({
  where: { id: userId },
});

if (!user || user.role !== 'ADMIN') {
  await prisma.$disconnect();
  return Astro.redirect('/painel-organizador');
}

const { id } = Astro.params;

if (!id) {
  await prisma.$disconnect();
  return Astro.redirect('/admin/dashboard');
}

const event = await prisma.event.findUnique({
  where: { id },
  include: {
    tenant: true,
    categories: true,
    batches: true,
  }
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/admin/dashboard');
}
---

<BaseLayout title={`Moderação: ${event.title}`}>
  <!-- Cabeçalho HUD -->
  <section class="bg-[#08090c] border-b border-zinc-900 py-8 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-start font-mono text-[10px] tracking-widest text-zinc-500 gap-2">
      <a href="/admin/dashboard" class="hover:text-emerald-400 transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Voltar para Painel Geral
      </a>
      <div class="flex items-center gap-4">
        <span class="text-emerald-400 font-bold">MODERAÇÃO DE EVENTOS</span>
        <span class="text-zinc-700">|</span>
        <span class="text-zinc-400 font-semibold">REVISÃO DETALHADA</span>
      </div>
      <h1 class="font-heading text-3xl font-extrabold uppercase text-white tracking-wider mt-2">
        {event.title}
      </h1>
      <div class="text-[10px] uppercase text-zinc-500 mt-1">
        Organização: <span class="text-zinc-300 font-bold">{event.tenant.name}</span>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full font-mono text-xs">
    <div class="bg-[#15171f] border border-zinc-800 p-8 space-y-8 relative">
      <div class="absolute top-0 right-0 w-12 h-12 border-t border-r border-zinc-700 pointer-events-none"></div>

      <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
        <h2 class="font-heading text-xl font-bold text-white uppercase tracking-wider">
          Dados do Evento
        </h2>
        <div>
          {event.status === 'DRAFT' && (
            <span class="bg-amber-500/10 border border-amber-500/20 text-amber-500 text-[10px] uppercase px-3 py-1 font-bold tracking-wider">
              Aguardando Aprovação
            </span>
          )}
          {event.status === 'PUBLISHED' && (
            <span class="bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] uppercase px-3 py-1 font-bold tracking-wider">
              Publicado
            </span>
          )}
          {event.status === 'REJECTED' && (
            <span class="bg-red-500/10 border border-red-500/20 text-red-400 text-[10px] uppercase px-3 py-1 font-bold tracking-wider">
              Reprovado
            </span>
          )}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <div class="text-[9px] text-zinc-500 uppercase tracking-wider mb-1">Modalidade</div>
            <div class="text-zinc-200 uppercase font-bold bg-[#0d0e12] border border-zinc-800 px-4 py-3">
              {event.eventType}
            </div>
          </div>
          <div>
            <div class="text-[9px] text-zinc-500 uppercase tracking-wider mb-1">Data & Horário</div>
            <div class="text-zinc-200 bg-[#0d0e12] border border-zinc-800 px-4 py-3">
              {new Date(event.date).toLocaleString('pt-BR')}
            </div>
          </div>
          <div>
            <div class="text-[9px] text-zinc-500 uppercase tracking-wider mb-1">Limite Geral de Vagas</div>
            <div class="text-zinc-200 bg-[#0d0e12] border border-zinc-800 px-4 py-3">
              {event.availableSlots} vagas
            </div>
          </div>
          <div>
            <div class="text-[9px] text-zinc-500 uppercase tracking-wider mb-1">Localização</div>
            <div class="text-zinc-200 bg-[#0d0e12] border border-zinc-800 px-4 py-3 truncate" title={event.location || 'Não informado'}>
              {event.location || 'NÃO INFORMADO'}
            </div>
            {event.locationUrl && (
              <iframe 
                src={event.locationUrl} 
                class="w-full h-64 mt-2 border border-zinc-900 grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500" 
                allowfullscreen="" 
                loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"
                title={`Mapa de localização para ${event.title}`}
              ></iframe>
            )}
          </div>
        </div>

        <div class="space-y-4">
          <div class="text-[9px] text-zinc-500 uppercase tracking-wider mb-1">Preview de Mídia</div>
          <div class="bg-[#0d0e12] border border-zinc-800 p-4 h-full flex flex-col items-center justify-center gap-4">
            {event.logoUrl && (
              <img src={event.logoUrl} alt="Logo" class="w-16 h-16 object-cover rounded-full border border-zinc-700" />
            )}
            {event.bannerUrl ? (
              <img src={event.bannerUrl} alt="Banner" class="w-full h-32 object-cover border border-zinc-700" />
            ) : (
              <div class="w-full h-32 bg-zinc-900 border border-zinc-800 flex items-center justify-center text-zinc-600">Sem Banner</div>
            )}
            {event.trailerUrl && (
              <div class="w-full mt-4">
                <div class="text-[9px] text-zinc-500 uppercase tracking-wider mb-2 text-center">Trailer Promocional</div>
                <div class="aspect-w-16 aspect-h-9 relative w-full h-0 pb-[56.25%] border border-zinc-800">
                  <iframe 
                    src={event.trailerUrl} 
                    title="YouTube video player" 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    class="absolute top-0 left-0 w-full h-full grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
                  ></iframe>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <div class="border-t border-zinc-800 pt-6 mb-6">
        <h3 class="font-heading text-sm font-bold text-white uppercase tracking-wider mb-4">
          Informações Básicas / Descrição
        </h3>
        <div class="bg-[#0d0e12] border border-zinc-800 p-4 text-zinc-400 font-sans text-xs whitespace-pre-wrap max-h-48 overflow-y-auto">
          {event.description || 'SEM DESCRIÇÃO INFORMADA'}
        </div>
      </div>

      <div class="border-t border-zinc-800 pt-6">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-heading text-sm font-bold text-white uppercase tracking-wider">
            Regulamento
          </h3>
          <button id="toggle-markdown" class="text-[10px] uppercase text-zinc-400 hover:text-white border border-zinc-800 px-2 py-1 transition-colors cursor-pointer">
            Ver em Texto Original
          </button>
        </div>
        
        <div id="contract-html" class="bg-[#0d0e12] border border-zinc-800 p-4 text-zinc-300 font-sans text-xs max-h-64 overflow-y-auto markdown-body space-y-4">
          <Fragment set:html={event.contractText ? marked.parse(event.contractText) : 'SEM TEXTO DE REGULAMENTO'} />
        </div>

        <div id="contract-text" class="hidden bg-[#0d0e12] border border-zinc-800 p-4 text-zinc-400 font-sans text-xs whitespace-pre-wrap max-h-64 overflow-y-auto">
          {event.contractText || 'SEM TEXTO DE REGULAMENTO'}
        </div>
        {event.contractPdf && (
          <div class="mt-4">
            <a href={event.contractPdf} target="_blank" class="text-blue-400 hover:underline uppercase text-[10px] font-bold">
              Visualizar PDF do Regulamento
            </a>
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-zinc-800 pt-6">
        <div>
          <h3 class="font-heading text-sm font-bold text-white uppercase tracking-wider mb-4">
            Categorias
          </h3>
          <ul class="space-y-2">
            {event.categories.map((cat: any) => (
              <li class="bg-[#0d0e12] border border-zinc-800 px-4 py-3 flex items-center justify-between">
                <span class="text-zinc-200 uppercase font-bold text-[10px]">{cat.name}</span>
                <span class="text-zinc-500 text-[10px]">{genderMap[cat.gender] || cat.gender} — {cat.availableSlots} vagas</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-heading text-sm font-bold text-white uppercase tracking-wider mb-4">
            Lotes
          </h3>
          <ul class="space-y-2">
            {event.batches.map((bat: any) => (
              <li class="bg-[#0d0e12] border border-zinc-800 px-4 py-3 flex items-center justify-between">
                <span class="text-zinc-200 uppercase font-bold text-[10px]">{bat.name}</span>
                <span class="text-emerald-400 font-bold text-[10px]">
                  {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(bat.price))}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="border-t border-zinc-800 pt-8 mt-8 flex flex-col md:flex-row items-center justify-between gap-4">
        {event.status === 'DRAFT' ? (
          <>
            <button
              onclick={`reprovarEvento('${event.id}')`}
              class="w-full md:w-auto border border-red-500/50 hover:bg-red-500/10 text-red-400 text-xs uppercase px-8 py-4 font-extrabold tracking-widest transition-colors cursor-pointer text-center"
            >
              Reprovar Evento
            </button>
            <button
              onclick={`aprovarEvento('${event.id}')`}
              class="w-full md:w-auto bg-emerald-500 hover:bg-emerald-600 text-black text-xs uppercase px-12 py-4 font-extrabold tracking-widest transition-colors cursor-pointer text-center"
            >
              Aprovar & Publicar
            </button>
          </>
        ) : (
          <div class="text-zinc-500 text-[10px] uppercase w-full text-center">
            Este evento já foi moderado. Ações não estão mais disponíveis.
          </div>
        )}
      </div>

    </div>
  </section>

  <!-- Scripts de Moderação -->
  <script is:inline>
    function initMarkdownToggle() {
      const toggleBtn = document.getElementById('toggle-markdown');
      const htmlView = document.getElementById('contract-html');
      const textView = document.getElementById('contract-text');
      
      if (!toggleBtn || toggleBtn.dataset.init) return;
      toggleBtn.dataset.init = 'true';

      let isHtml = true;
      toggleBtn.addEventListener('click', () => {
        isHtml = !isHtml;
        if (isHtml) {
          htmlView.classList.remove('hidden');
          textView.classList.add('hidden');
          toggleBtn.textContent = 'Ver em Texto Original';
        } else {
          htmlView.classList.add('hidden');
          textView.classList.remove('hidden');
          toggleBtn.textContent = 'Ver em Markdown';
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initMarkdownToggle);
    document.addEventListener('astro:page-load', initMarkdownToggle);
    setTimeout(initMarkdownToggle, 100);

    window.isSubmitting = false;

    window.aprovarEvento = async function(eventId) {
      if (window.isSubmitting) return;
      if (!await window.cyberConfirm('Deseja realmente aprovar este evento para publicação?')) return;
      
      window.isSubmitting = true;
      try {
        const response = await fetch('/api/admin/eventos/aprovar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ eventId })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao aprovar evento.');
        }

        await window.cyberAlert('Evento aprovado com sucesso!');
        window.location.href = '/admin/dashboard';
      } catch (err) {
        window.isSubmitting = false;
        await window.cyberAlert(err.message, 'ERRO_SISTEMA', 'error');
        if (err.message.includes('já foi moderado') || err.message.includes('Acesso negado')) {
          window.location.href = '/admin/dashboard';
        }
      }
    };

    window.reprovarEvento = async function(eventId) {
      if (window.isSubmitting) return;
      const reason = await window.cyberPrompt('Qual o motivo da reprovação? (O organizador verá esta mensagem)');
      if (!reason) return;
      
      window.isSubmitting = true;
      try {
        const response = await fetch('/api/admin/eventos/reprovar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ eventId, reason })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao reprovar evento.');
        }

        await window.cyberAlert('Evento reprovado!');
        window.location.href = '/admin/dashboard';
      } catch (err) {
        window.isSubmitting = false;
        await window.cyberAlert(err.message, 'SYSTEM_ERROR', 'error');
      }
    };
  </script>
</BaseLayout>
