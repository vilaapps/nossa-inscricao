---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import EditEventForm from '../../../components/react/EditEventForm';

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

// Validar role de organizador no banco de dados local
const user = await prisma.user.findUnique({
  where: { id: userId },
});

if (!user || (user.role !== 'ORGANIZER' && user.role !== 'ADMIN')) {
  await prisma.$disconnect();
  return Astro.redirect('/admin/dashboard');
}

// Obter ID do evento a ser editado via query parameter
const url = new URL(Astro.request.url);
const eventId = url.searchParams.get('id');

if (!eventId) {
  await prisma.$disconnect();
  return Astro.redirect('/admin/dashboard');
}

// Buscar evento com categorias e lotes
const event = await prisma.event.findUnique({
  where: { id: eventId },
  include: {
    categories: true,
    batches: true,
  },
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/admin/dashboard');
}

// Validar se o evento pertence à organização do usuário (a não ser que seja admin)
if (user.role === 'ORGANIZER' && event.tenantId !== user.tenantId) {
  return Astro.redirect('/admin/dashboard');
}

// Validar se o evento está em DRAFT
if (event.status !== 'DRAFT') {
  return Astro.redirect('/admin/dashboard');
}
---

<BaseLayout title="Editar Evento — Painel Organizador">
  <!-- Cabeçalho HUD Simplificado -->
  <section class="bg-[#08090c] border-b border-zinc-900 py-8 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-start font-mono text-[10px] tracking-widest text-zinc-500 gap-2">
      <a href="/admin/dashboard" class="hover:text-emerald-400 transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Voltar para o Dashboard
      </a>
      <div class="flex items-center gap-4">
        <span class="text-emerald-400 font-bold">GERENCIAMENTO DE COMPETIÇÕES</span>
        <span class="text-zinc-700">|</span>
        <span class="text-zinc-400 font-semibold">EDITAR EVENTO (RASCUNHO)</span>
      </div>
    </div>
  </section>

  <!-- Área do Formulário -->
  <section class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
    <EditEventForm client:load event={event} />
  </section>
</BaseLayout>
