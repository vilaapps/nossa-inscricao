---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

// Buscar usuario no banco local para verificar role e tenant
let user = await prisma.user.findUnique({
  where: { id: userId },
});

// Se o usuário não existir localmente, criamos o cadastro inicial como PARTICIPANT ou ADMIN
if (!user) {
  const clerkUser = await Astro.locals.currentUser();
  if (!clerkUser) {
    await prisma.$disconnect();
    return Astro.redirect('/');
  }
  const email = clerkUser.emailAddresses[0]?.emailAddress || '';
  const name = clerkUser.firstName ? `${clerkUser.firstName} ${clerkUser.lastName || ''}`.trim() : '';
  
  const isSuperAdmin = email === 'nossainscricao@gmail.com';
  
  if (isSuperAdmin) {
    await prisma.tenant.upsert({
      where: { id: 'tenant-platform' },
      update: {},
      create: {
        id: 'tenant-platform',
        name: 'Plataforma Nossa Inscrição',
        commissionRate: 10.00,
      }
    });

    user = await prisma.user.create({
      data: {
        id: userId,
        email,
        name,
        role: 'ADMIN',
        tenantId: 'tenant-platform',
      }
    });
  } else {
    user = await prisma.user.create({
      data: {
        id: userId,
        email,
        name,
        role: 'PARTICIPANT',
      }
    });
  }
}

// Apenas ADMIN pode acessar esta rota — redirecionar outros roles
if (user.role !== 'ADMIN') {
  await prisma.$disconnect();
  return Astro.redirect('/painel-organizador');
}

let events: any[] = [];
let pendingEvents: any[] = [];
let allTenants: any[] = [];

// Super Admin: Buscar todos os eventos
events = await prisma.event.findMany({
  include: {
    tenant: true,
    categories: true,
    batches: true,
    registrations: {
      include: {
        payment: true,
      }
    }
  }
});

// Eventos pendentes de aprovação
pendingEvents = await prisma.event.findMany({
  where: { status: 'DRAFT' },
  include: {
    tenant: true,
  }
});

// Todos os tenants cadastrados
allTenants = await prisma.tenant.findMany({
  include: {
    users: {
      where: { role: 'ORGANIZER' }
    }
  }
});

await prisma.$disconnect();

// --- Cálculos Estatísticos para Super Admin ---
let adminStats = {
  totalRevenueGlobal: 0,
  totalCommissionsGlobal: 0,
  totalRegistrationsGlobal: 0,
  confirmedRegistrationsGlobal: 0,
  activeEventsCount: 0,
};

events.forEach(event => {
  if (event.status === 'PUBLISHED') {
    adminStats.activeEventsCount++;
  }
  const rate = Number(event.tenant?.commissionRate || 10) / 100;
  event.registrations.forEach((reg: any) => {
    adminStats.totalRegistrationsGlobal++;
    if (reg.paymentStatus === 'PAID' || reg.status === 'CONFIRMED') {
      const val = Number(reg.amountPaid);
      adminStats.totalRevenueGlobal += val;
      adminStats.totalCommissionsGlobal += val * rate;
      adminStats.confirmedRegistrationsGlobal++;
    }
  });
});
---

<BaseLayout title="Painel Geral de Moderação">
  <!-- TELA DO SUPER ADMIN (PLATAFORMA) -->
  <section class="bg-[#08090c] border-b border-zinc-900 py-12 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6 font-mono">
      <div>
        <div class="text-[10px] uppercase tracking-widest text-emerald-400 mb-2 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
          Super Admin Geral da Plataforma // {user.email}
        </div>
        <h1 class="font-heading text-3xl font-extrabold uppercase text-white tracking-wider">
          Painel Geral
        </h1>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-12 space-y-12 flex-grow w-full font-mono text-xs">
    <!-- Grid de Métricas Globais HUD -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-[#15171f] border border-zinc-800 p-5 relative">
        <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Faturamento Bruto Geral</div>
        <div class="text-3xl font-bold text-white mt-2">
          {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(adminStats.totalRevenueGlobal)}
        </div>
        <div class="text-[9px] text-zinc-600 uppercase mt-2">Volume transacionado no Asaas</div>
        <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-zinc-800"></div>
      </div>

      <div class="bg-[#15171f] border border-zinc-800 p-5 relative">
        <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Comissões da Plataforma</div>
        <div class="text-3xl font-bold text-emerald-400 mt-2">
          {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(adminStats.totalCommissionsGlobal)}
        </div>
        <div class="text-[9px] text-emerald-600 uppercase mt-2">Lucro retido pelas taxas</div>
        <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-zinc-800"></div>
      </div>

      <div class="bg-[#15171f] border border-zinc-800 p-5 relative">
        <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Inscrições Globais</div>
        <div class="text-3xl font-bold text-white mt-2">
          {adminStats.confirmedRegistrationsGlobal} <span class="text-xs text-zinc-500">/ {adminStats.totalRegistrationsGlobal}</span>
        </div>
        <div class="text-[9px] text-zinc-600 uppercase mt-2">Inscrições pagas vs solicitadas</div>
        <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-zinc-800"></div>
      </div>

      <div class="bg-[#15171f] border border-zinc-800 p-5 relative">
        <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Eventos Publicados</div>
        <div class="text-3xl font-bold text-blue-400 mt-2">
          {adminStats.activeEventsCount}
        </div>
        <div class="text-[9px] text-zinc-600 uppercase mt-2">Competições ativas no ar</div>
        <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-zinc-800"></div>
      </div>
    </div>

    <!-- Área de Moderação de Eventos Pendentes -->
    <div class="space-y-6">
      <h3 class="font-heading text-lg font-bold text-white uppercase tracking-wider border-b border-zinc-800 pb-4 flex items-center gap-2">
        <span>Moderação de Eventos</span>
        {pendingEvents.length > 0 && (
          <span class="bg-amber-500/10 border border-amber-500/20 text-amber-500 text-[10px] px-2 py-0.5 font-mono tracking-normal animate-pulse">
            {pendingEvents.length} Pendentes
          </span>
        )}
      </h3>

      {pendingEvents.length === 0 ? (
        <div class="bg-[#15171f] border border-zinc-800 p-8 text-center text-zinc-500 uppercase">
          Nenhum evento aguardando moderação no momento.
        </div>
      ) : (
        <div class="border border-zinc-800 overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-[#0d0e12] text-zinc-500 border-b border-zinc-800 text-[10px] uppercase tracking-wider">
                <th class="p-4">Evento / Competição</th>
                <th class="p-4">Organização (Tenant)</th>
                <th class="p-4">Data da Prova</th>
                <th class="p-4 text-center">Vagas</th>
                <th class="p-4 text-center">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-900 bg-[#15171f]">
              {pendingEvents.map((event) => (
                <tr class="hover:bg-[#1a1c25] transition-colors">
                  <td class="p-4 font-bold text-zinc-200 uppercase">{event.title}</td>
                  <td class="p-4 text-zinc-400 uppercase">{event.tenant.name}</td>
                  <td class="p-4 text-zinc-400">
                    {new Date(event.date).toLocaleDateString('pt-BR')} {new Date(event.date).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })}
                  </td>
                  <td class="p-4 text-center text-zinc-300">{event.availableSlots}</td>
                  <td class="p-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      <a
                        href={`/admin/eventos/${event.id}`}
                        class="border border-zinc-800 hover:border-zinc-700 text-blue-400 hover:text-blue-300 text-[10px] uppercase px-4 py-2 font-extrabold tracking-wider transition-colors"
                      >
                        Ver Detalhes
                      </a>
                      <button
                        onclick={`aprovarEvento('${event.id}')`}
                        class="bg-emerald-500 hover:bg-emerald-600 text-black text-[10px] uppercase px-4 py-2 font-extrabold tracking-wider transition-colors cursor-pointer"
                      >
                        Aprovar
                      </button>
                      <button
                        onclick={`reprovarEvento('${event.id}')`}
                        class="bg-red-500 hover:bg-red-600 text-white text-[10px] uppercase px-4 py-2 font-extrabold tracking-wider transition-colors cursor-pointer"
                      >
                        Reprovar
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>

    <!-- Configuração de Tenants e Comissões -->
    <div class="space-y-6">
      <h3 class="font-heading text-lg font-bold text-white uppercase tracking-wider border-b border-zinc-800 pb-4">
        Parceiros / Taxas de Comissão
      </h3>

      <div class="border border-zinc-800 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-[#0d0e12] text-zinc-500 border-b border-zinc-800 text-[10px] uppercase tracking-wider">
              <th class="p-4">Organização (Tenant)</th>
              <th class="p-4">ID do Tenant</th>
              <th class="p-4 text-center">E-mail do Responsável</th>
              <th class="p-4 text-center">Taxa de Comissão (%)</th>
              <th class="p-4 text-center">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-900 bg-[#15171f]">
            {allTenants.map((item) => (
              <tr class="hover:bg-[#1a1c25] transition-colors">
                <td class="p-4 font-bold text-zinc-200 uppercase">{item.name}</td>
                <td class="p-4 text-zinc-500 font-mono">{item.id}</td>
                <td class="p-4 text-center text-zinc-400">{item.users[0]?.email || 'Não cadastrado'}</td>
                <td class="p-4 text-center w-48">
                  <div class="flex items-center justify-center gap-2">
                    <input
                      type="number"
                      id={`comissao-${item.id}`}
                      step="0.01"
                      min="0"
                      max="100"
                      value={Number(item.commissionRate)}
                      class="w-20 bg-[#0d0e12] border border-zinc-800 text-zinc-300 text-center px-2 py-1.5 outline-none focus:border-emerald-500 transition-colors"
                    />
                    <span class="text-zinc-500">%</span>
                  </div>
                </td>
                <td class="p-4 text-center">
                  <button
                    onclick={`salvarComissao('${item.id}')`}
                    class="border border-zinc-700 hover:border-emerald-500 text-zinc-400 hover:text-emerald-400 text-[10px] uppercase px-4 py-2 font-bold tracking-wider transition-colors cursor-pointer"
                  >
                    Salvar Taxa
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Scripts de Ação do Administrador -->
  <script is:inline>
    async function aprovarEvento(eventId) {
      if (!confirm('Deseja realmente aprovar este evento para publicação?')) return;
      
      try {
        const response = await fetch('/api/admin/eventos/aprovar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ eventId })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao aprovar evento.');
        }

        alert('Evento aprovado com sucesso!');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    async function reprovarEvento(eventId) {
      const reason = prompt('Qual o motivo da reprovação? (O organizador verá esta mensagem)');
      if (!reason) return;
      
      try {
        const response = await fetch('/api/admin/eventos/reprovar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ eventId, reason })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao reprovar evento.');
        }

        alert('Evento reprovado!');
        window.location.reload();
      } catch (err) {
        alert(err.message);
      }
    }

    async function salvarComissao(tenantId) {
      const input = document.getElementById(`comissao-${tenantId}`);
      const rate = parseFloat(input.value);

      if (isNaN(rate) || rate < 0 || rate > 100) {
        alert('Por favor, informe uma taxa válida entre 0 e 100.');
        return;
      }

      try {
        const response = await fetch('/api/admin/tenants/comissao', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ tenantId, commissionRate: rate })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao atualizar a comissão.');
        }

        alert('Taxa de comissão atualizada com sucesso!');
      } catch (err) {
        alert(err.message);
      }
    }
  </script>
</BaseLayout>
