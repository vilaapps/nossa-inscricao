---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import { SignInButton } from '@clerk/astro/components';
import { marked } from 'marked';

const { userId } = Astro.locals.auth();

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const prisma = new PrismaClient();

// Buscar evento pelo slug com categorias e lotes ativos
const event = await prisma.event.findFirst({
  where: { slug, status: 'PUBLISHED' },
  include: {
    categories: true,
    batches: {
      where: { active: true },
    },
  },
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/404');
}

// Formatador de data
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(date);
};

// Lote ativo padrão
const activeBatch = event.batches.find((b) => b.active);

// Formatar moeda
const formatCurrency = (val: number) => {
  return new Intl.NumberFormat('pt-BR', {
    style: 'currency',
    currency: 'BRL',
  }).format(val);
};

const defaultContractText = `CONTRATO E REGULAMENTO PADRÃO DE INSCRIÇÃO EM EVENTOS

1. DO OBJETIVO E ACEITE DOS TERMOS
Ao se inscrever neste evento, o participante declara estar de acordo com todas as regras e condições estabelecidas pelo organizador, bem como as normas de segurança do local da prova.

2. DAS CONDIÇÕES FÍSICAS E RESPONSABILIDADE
O participante assume total responsabilidade por suas condições de saúde física e mental, declarando-se apto a participar das atividades propostas e isentando os organizadores de qualquer responsabilidade por acidentes ou problemas de saúde ocorridos durante o evento.

3. DO CANCELAMENTO E REEMBOLSO
O cancelamento da inscrição obedecerá aos prazos e condições definidas em lei (Código de Defesa do Consumidor). Solicitações feitas fora do prazo legal não darão direito a reembolso dos valores pagos.

4. DIREITO DE IMAGEM
O participante cede gratuitamente os direitos de uso de sua imagem (fotos e vídeos capturados durante o evento) para fins de divulgação e publicidade do evento e da plataforma organizadora.`;
---

<BaseLayout title={event.title} description={event.description || ''}>
  <!-- Top Header HUD -->
  <section class="bg-surface border-b border-ink-muted/20 py-8 px-6">
    <div class="max-w-7xl mx-auto flex flex-col items-start font-mono text-xs tracking-widest text-ink-muted gap-2">
      <a href="/" class="hover:text-accent transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Voltar para a listagem
      </a>
      <div class="flex items-center gap-4">
        <span class="text-accent font-bold">DETALHES DO EVENTO</span>
      </div>
    </div>
  </section>

  <!-- Corpo da Página -->
  <section class="max-w-7xl mx-auto px-6 py-12 flex-grow">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
      <!-- Coluna Esquerda: Informações do Evento (2/3) -->
      <div class="lg:col-span-2 space-y-8">
        <div>
          {event.bannerUrl && (
            <img 
              src={event.bannerUrl} 
              alt={`Banner de ${event.title}`} 
              class="w-full h-auto object-cover max-h-[400px] border border-ink-muted/20 mb-6" 
            />
          )}

          <div class="flex items-center gap-4 mb-6">
            {event.logoUrl && (
              <img 
                src={event.logoUrl} 
                alt={`Logo de ${event.title}`} 
                class="w-16 h-16 object-cover border border-ink-muted/20 rounded-full" 
              />
            )}
            <h1 class="font-heading text-3xl md:text-5xl font-black text-ink uppercase tracking-tight leading-none">
              {event.title}
            </h1>
          </div>

          <div class="flex flex-wrap gap-4 text-xs font-mono text-ink-muted">
            <div class="bg-surface-alt border border-ink-muted/20 px-3 py-1.5 uppercase text-ink">
              📅 {formatDate(event.date)}
            </div>
            <div class="bg-surface-alt border border-ink-muted/20 px-3 py-1.5 uppercase text-ink">
              👥 Vagas Restantes: {event.availableSlots}
            </div>
          </div>
        </div>

        <div class="border-t border-ink-muted/20 pt-8 space-y-6">
          <h2 class="font-heading text-lg font-bold text-ink uppercase tracking-wider">Sobre a Competição</h2>
          <p class="text-ink-muted text-sm leading-relaxed whitespace-pre-line font-sans">
            {event.description || 'Nenhuma descrição detalhada disponível para este evento.'}
          </p>

          {event.trailerUrl && (
            <div class="mt-8 border-t border-ink-muted/20 pt-6">
              <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider mb-4 flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-red-500 rounded-full"></span>
                Trailer Promocional
              </h3>
              <div class="aspect-w-16 aspect-h-9 relative w-full h-0 pb-[56.25%] border border-ink-muted/20">
                <iframe 
                  src={event.trailerUrl} 
                  title="YouTube video player" 
                  frameborder="0" 
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                  allowfullscreen
                  class="absolute top-0 left-0 w-full h-full grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500"
                ></iframe>
              </div>
            </div>
          )}
        </div>

        <!-- Regulamento Dinâmico -->
        <div class="bg-surface-alt border border-ink-muted/20 p-6 space-y-6 shadow-sm">
          <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-2 border-b border-ink-muted/20 pb-3">
            <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
            Regulamento & Contrato Oficial
          </h3>

          {event.contractPdf ? (
            <div class="space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface border border-ink-muted/20 p-4 font-mono text-xs text-ink-muted">
                <div>
                  <div class="font-bold text-ink uppercase">Regulamento em Formato PDF</div>
                  <div class="text-xs text-ink-muted mt-0.5">O organizador disponibilizou os termos em arquivo oficial.</div>
                </div>
                <a
                  href={event.contractPdf}
                  download={`${event.slug}-regulamento.pdf`}
                  class="bg-blue-500/10 hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 text-center font-bold uppercase tracking-wider text-xs px-4 py-2.5 border border-blue-500/30 transition-all font-mono"
                  target="_blank"
                >
                  Visualizar / Baixar PDF
                </a>
              </div>
              <iframe
                src={event.contractPdf}
                class="w-full h-[500px] border border-ink-muted/20 bg-surface"
                title="Regulamento Oficial do Evento"
              />
            </div>
          ) : (
            <div class="text-xs text-ink-muted font-sans space-y-4 max-h-[400px] overflow-y-auto pr-2 markdown-body">
              <Fragment set:html={marked.parse(event.contractText || defaultContractText)} />
            </div>
          )}
        </div>

        <!-- Localização Google Maps (Caso 2) -->
        {(event.location || event.locationUrl) && (
          <div class="bg-surface-alt border border-ink-muted/20 p-6 space-y-6 shadow-sm">
            <h3 class="font-heading text-sm font-bold text-ink uppercase tracking-wider flex items-center gap-2 border-b border-ink-muted/20 pb-3">
              <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span>
              Localização do Evento
            </h3>

            {event.locationUrl ? (
              <div class="space-y-4">
                <div class="text-xs text-ink font-mono uppercase tracking-wider bg-surface border border-ink-muted/20 p-3 flex items-center gap-2">
                  <span>📍</span>
                  {event.location || "Local da Prova"}
                </div>
                <iframe 
                  src={event.locationUrl} 
                  class="w-full h-[350px] border border-ink-muted/20 grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-500" 
                  allowfullscreen="" 
                  loading="lazy" 
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mapa de localização para ${event.title}`}
                ></iframe>
              </div>
            ) : (
              <div class="text-xs text-ink font-mono uppercase tracking-wider bg-surface border border-ink-muted/20 p-4 flex items-center gap-2">
                <span>📍</span>
                {event.location}
              </div>
            )}
          </div>
        )}
      </div>

      <!-- Coluna Direita: Painel HUD de Inscrição (1/3) -->
      <div class="bg-surface-alt border border-ink-muted/20 p-6 relative shadow-sm">
        <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-ink-muted/20 pointer-events-none"></div>
        
        <h2 class="font-heading text-lg font-bold text-ink uppercase tracking-wider mb-6 pb-4 border-b border-ink-muted/20 flex items-center justify-between">
          <span>Inscrição</span>
          <span class="text-emerald-600 dark:text-emerald-400 text-xs font-mono font-normal tracking-normal uppercase">Lote Ativo</span>
        </h2>

        {activeBatch ? (
          <div class="space-y-6">
            <!-- Informações do Lote -->
            <div class="bg-surface border border-ink-muted/20 p-4 font-mono">
              <div class="text-xs font-semibold text-ink-muted uppercase">Nome do Lote</div>
              <div class="text-ink text-sm font-bold mt-0.5">{activeBatch.name}</div>
              
              <div class="grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-ink-muted/20 text-xs">
                <div>
                  <span class="text-ink-muted block uppercase">Valor Base</span>
                  <span class="text-emerald-600 dark:text-emerald-400 font-bold text-sm block mt-0.5">{formatCurrency(Number(activeBatch.price))}</span>
                </div>
                <div>
                  <span class="text-ink-muted block uppercase">Taxa Adm</span>
                  <span class="text-ink block mt-0.5">Grátis</span>
                </div>
              </div>
            </div>

            <!-- CTA de Inscrição HUD -->
            <div class="space-y-4">
              {userId ? (
                <a
                  href={`/inscricao/${event.id}`}
                  class="block w-full text-center bg-emerald-500 hover:bg-emerald-600 text-black font-mono text-xs uppercase py-4 tracking-widest font-extrabold transition-all duration-200"
                >
                  Fazer Inscrição
                </a>
              ) : (
                <>
                  <SignInButton mode="modal" forceRedirectUrl={`/inscricao/${event.id}`} asChild>
                    <button class="w-full bg-accent hover:opacity-90 text-white font-mono text-xs uppercase py-4 tracking-widest font-extrabold transition-all duration-200 text-center cursor-pointer shadow-sm">
                      Login para Fazer Inscrição
                    </button>
                  </SignInButton>
                  <span class="block text-center text-xs text-ink-muted font-mono uppercase mt-2">
                    Faça login para garantir sua vaga de forma imediata
                  </span>
                </>
              )}
            </div>
          </div>
        ) : (
          <div class="border border-dashed border-ink-muted/30 p-6 text-center text-ink-muted font-mono text-xs">
            NENHUM LOTE ATIVO ENCONTRADO PARA ESTE EVENTO. AS INSCRIÇÕES ESTÃO INDISPONÍVEIS.
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
