---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import { maskName, maskCpf } from '@syncflow/shared';

const { code } = Astro.params;
const normalizedCode = (code || '').trim().toUpperCase();

const prisma = new PrismaClient();

const registration = await prisma.registration.findUnique({
  where: { receiptCode: normalizedCode },
  include: {
    event: true,
    category: true,
    batch: true,
    user: true,
  },
});

await prisma.$disconnect();

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
};

const isValid = registration && registration.status === 'CONFIRMED';
const metadata = (registration?.metadata as any) || {};
const userMetadata = (registration?.user?.metadata as any) || {};
const athleteCpf = (registration?.user as any)?.cpf || userMetadata.cpf || metadata.cpf || '';
---

<BaseLayout title={`Verificação de Comprovante: ${normalizedCode}`}>
  <section class="bg-surface border-b border-ink-muted/20 py-12 px-6">
    <div class="max-w-4xl mx-auto text-center font-mono">
      <div class="text-xs uppercase tracking-widest text-ink-muted mb-2 font-medium">
        Validação de Autenticidade Digital
      </div>
      <h1 class="font-heading text-2xl md:text-4xl font-extrabold uppercase text-ink tracking-wider">
        Verificação de Inscrição
      </h1>
      <p class="text-ink-muted text-sm mt-2 max-w-xl mx-auto">
        Verifique a autenticidade e validade do comprovante oficial gerado pela plataforma SyncFlow.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 flex-grow w-full">
    {registration ? (
      <div class="bg-surface-alt border border-ink-muted/20 p-6 md:p-10 relative shadow-sm font-mono space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-ink-muted/20 pb-6">
          <div>
            <span class="text-xs uppercase text-ink-muted block font-semibold">Código de Verificação</span>
            <span class="text-xl md:text-2xl font-bold text-ink tracking-widest">{registration.receiptCode}</span>
          </div>

          <div>
            {isValid ? (
              <span class="inline-flex items-center gap-2 px-4 py-2 border border-emerald-500/40 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs md:text-sm font-bold uppercase tracking-wider">
                <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></span>
                Inscrição Confirmada & Válida
              </span>
            ) : (
              <span class="inline-flex items-center gap-2 px-4 py-2 border border-red-500/40 bg-red-500/10 text-red-600 dark:text-red-400 text-xs md:text-sm font-bold uppercase tracking-wider">
                <span class="w-2.5 h-2.5 bg-red-500 rounded-full"></span>
                Inscrição {registration.status === 'CANCELLED' ? 'Cancelada' : 'Não Confirmada'}
              </span>
            )}
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-8 text-sm">
          <div>
            <span class="text-xs text-ink-muted uppercase font-semibold block">Evento</span>
            <span class="text-base text-ink font-bold mt-1 block">{registration.event.title}</span>
          </div>

          <div>
            <span class="text-xs text-ink-muted uppercase font-semibold block">Data do Evento</span>
            <span class="text-base text-ink font-semibold mt-1 block">{formatDate(registration.event.date)}</span>
          </div>

          <div>
            <span class="text-xs text-ink-muted uppercase font-semibold block">Atleta (Identidade Protegida)</span>
            <span class="text-base text-ink font-bold mt-1 block tracking-wider">
              {maskName(registration.user?.name || 'Participante')}
            </span>
            {athleteCpf && (
              <span class="text-xs text-ink-muted block mt-0.5">
                CPF: {maskCpf(athleteCpf)}
              </span>
            )}
          </div>

          <div>
            <span class="text-xs text-ink-muted uppercase font-semibold block">Categoria</span>
            <span class="text-base text-ink font-semibold mt-1 block">{registration.category.name}</span>
          </div>

          <div>
            <span class="text-xs text-ink-muted uppercase font-semibold block">Local da Prova</span>
            <span class="text-base text-ink font-medium mt-1 block">{registration.event.location}</span>
          </div>

          <div>
            <span class="text-xs text-ink-muted uppercase font-semibold block">Data de Emissão</span>
            <span class="text-base text-ink font-medium mt-1 block">{formatDate(registration.updatedAt)}</span>
          </div>
        </div>

        <div class="border-t border-ink-muted/20 pt-6 text-xs text-ink-muted leading-relaxed font-sans">
          <p>
            Esta página atesta publicamente a autenticidade do comprovante emitido pela SyncFlow. Em conformidade com a LGPD, dados sensíveis como e-mail, telefone e número integral de documentos são preservados e não são expostos nesta consulta pública.
          </p>
        </div>
      </div>
    ) : (
      <div class="bg-surface-alt border border-red-500/30 p-10 text-center font-mono space-y-6 shadow-sm">
        <div class="w-16 h-16 bg-red-500/10 border border-red-500/40 rounded-full flex items-center justify-center text-red-500 text-2xl font-bold mx-auto">
          ✕
        </div>
        <div>
          <h2 class="font-heading text-xl md:text-2xl font-bold uppercase text-ink tracking-wider">
            Comprovante Não Encontrado
          </h2>
          <p class="text-ink-muted text-sm mt-2 max-w-md mx-auto">
            O código <span class="text-ink font-bold">{normalizedCode}</span> não corresponde a nenhuma inscrição registrada no sistema.
          </p>
        </div>
        <div class="pt-4">
          <a
            href="/"
            class="inline-block bg-surface border border-ink-muted/30 hover:border-accent text-ink text-xs uppercase px-8 py-3.5 tracking-widest font-semibold transition-all duration-200"
          >
            Voltar para o Início
          </a>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
