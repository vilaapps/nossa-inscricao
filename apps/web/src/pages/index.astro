---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

const url = new URL(Astro.request.url);
const currentFilter = url.searchParams.get('type') || 'TODOS';

// Filtro
const whereClause: any = { 
  status: 'PUBLISHED',
  date: { gt: new Date() } // Oculta eventos que já passaram
};

// Buscar eventos (traz todos para filtrar no cliente)
const events = await prisma.event.findMany({
  where: whereClause,
  include: {
    batches: {
      where: { active: true },
    },
    categories: true,
    _count: {
      select: {
        registrations: {
          where: {
            OR: [
              { paymentStatus: 'PAID' },
              { status: 'CONFIRMED' },
            ],
          },
        },
      },
    },
  },
  orderBy: { date: 'asc' },
});

await prisma.$disconnect();

// Calcular indicadores dinâmicos
const totalSlots = events.reduce((sum: number, e: any) => sum + e.availableSlots, 0);
const filledSlots = events.reduce((sum: number, e: any) => sum + e._count.registrations, 0);
const fillRate = totalSlots > 0 ? Math.round((filledSlots / totalSlots) * 100) : 0;

// Formatador de data em Portugues
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
};

// Obter preco inicial (menor preco de lote ativo)
const getStartingPrice = (event: any) => {
  const activeBatches = event.batches.filter((b: any) => b.active);
  if (activeBatches.length === 0) return 'Sob Consulta';
  const minPrice = Math.min(...activeBatches.map((b: any) => Number(b.price)));
  return new Intl.NumberFormat('pt-BR', {
    style: 'currency',
    currency: 'BRL',
  }).format(minPrice);
};
---

<BaseLayout title="Eventos Esportivos Ativos">
  <!-- Hero Section Editorial Brutalist -->
  <section class="relative bg-surface border-b border-ink-muted/20 py-20 px-6 overflow-hidden">
    <!-- Grade Minimalista -->
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="w-full h-full bg-[linear-gradient(to_right,var(--text-ink)_1px,transparent_1px),linear-gradient(to_bottom,var(--text-ink)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    </div>
    
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col items-start">
      <!-- Tag superior -->
      <div class="flex items-center gap-2 mb-6 text-[10px] font-sans font-bold uppercase tracking-widest text-accent">
        <span class="w-2 h-2 bg-accent animate-pulse"></span>
        INSCRIÇÕES ABERTAS
      </div>

      <!-- Headline brutalista massivo -->
      <h1 class="font-heading text-5xl md:text-[7rem] font-black uppercase tracking-tighter text-ink mb-6 leading-[0.85] max-w-5xl">
        SUA VAGA<br/>
        <span class="text-ink/30">GARANTIDA</span><br/>
        <span class="text-accent underline decoration-8 underline-offset-4">AGORA.</span>
      </h1>

      <!-- Subtitulo -->
      <p class="text-ink-muted font-sans text-base md:text-xl max-w-xl mb-10 leading-relaxed font-medium">
        A plataforma oficial para você superar limites. Inscrição rápida e segura para corridas, triatlo, mountain bike e ultra trail.
      </p>

      <!-- Stats do HUD na lateral inferior -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 border-t-2 border-ink pt-8 w-full max-w-3xl font-sans">
        <div>
          <div class="text-[10px] text-ink-muted font-bold uppercase tracking-wider">Eventos Ativos</div>
          <div class="text-3xl font-heading font-black text-ink mt-1">{events.length}</div>
        </div>
        <div>
          <div class="text-[10px] text-ink-muted font-bold uppercase tracking-wider">Vagas Preenchidas</div>
          <div class="text-3xl font-heading font-black text-ink mt-1">{fillRate}%</div>
        </div>
        <div>
          <div class="text-[10px] text-ink-muted font-bold uppercase tracking-wider">Atletas Inscritos</div>
          <div class="text-3xl font-heading font-black text-ink mt-1">{filledSlots}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtro & Listagem de Eventos -->
  <section class="max-w-7xl mx-auto px-6 py-16 flex-grow">
    <!-- Header da Secao -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b-2 border-ink pb-6 mb-12 gap-4">
      <div>
        <h2 class="font-heading text-3xl font-black uppercase tracking-tighter text-ink">Eventos Disponíveis</h2>
        <p class="text-ink-muted font-medium text-sm mt-1">Selecione uma competição e garanta seu lote com segurança.</p>
      </div>

      <!-- Barra de Filtro Editorial -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0" id="filter-container">
        <button data-filter="TODOS" class={`${currentFilter === 'TODOS' ? 'bg-accent text-surface border-accent' : 'border-ink-muted/30 text-ink-muted hover:text-ink hover:border-ink'} filter-btn border-2 text-xs font-sans font-bold uppercase px-4 py-2 tracking-widest transition-all duration-200 cursor-pointer`}>
          Todos
        </button>
        <button data-filter="CORRIDA" class={`${currentFilter === 'CORRIDA' ? 'bg-accent text-surface border-accent' : 'border-ink-muted/30 text-ink-muted hover:text-ink hover:border-ink'} filter-btn border-2 text-xs font-sans font-bold uppercase px-4 py-2 tracking-widest transition-all duration-200 cursor-pointer`}>
          Corrida
        </button>
        <button data-filter="CICLISMO" class={`${currentFilter === 'CICLISMO' ? 'bg-accent text-surface border-accent' : 'border-ink-muted/30 text-ink-muted hover:text-ink hover:border-ink'} filter-btn border-2 text-xs font-sans font-bold uppercase px-4 py-2 tracking-widest transition-all duration-200 cursor-pointer`}>
          Ciclismo
        </button>
        <button data-filter="ULTRA_TRAIL" class={`${currentFilter === 'ULTRA_TRAIL' ? 'bg-accent text-surface border-accent' : 'border-ink-muted/30 text-ink-muted hover:text-ink hover:border-ink'} filter-btn border-2 text-xs font-sans font-bold uppercase px-4 py-2 tracking-widest transition-all duration-200 cursor-pointer`}>
          Ultra Trail
        </button>
        <button data-filter="TRIATHLON" class={`${currentFilter === 'TRIATHLON' ? 'bg-accent text-surface border-accent' : 'border-ink-muted/30 text-ink-muted hover:text-ink hover:border-ink'} filter-btn border-2 text-xs font-sans font-bold uppercase px-4 py-2 tracking-widest transition-all duration-200 cursor-pointer`}>
          Triathlon
        </button>
      </div>
    </div>

    <!-- Grid de Eventos -->
    <div id="empty-state" class={`border-2 border-dashed border-ink-muted/40 p-12 text-center text-ink-muted font-sans font-bold uppercase tracking-widest ${events.length > 0 && events.some(e => currentFilter === 'TODOS' || e.eventType === currentFilter) ? 'hidden' : 'block'}`}>
      NENHUM EVENTO ENCONTRADO PARA O FILTRO SELECIONADO.
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="events-grid">
        {events.map((event) => {
          // Remover lógica frágil e usar o campo real do banco (Substituir underscores por espaço para UI)
          const categoryBadge = event.eventType ? event.eventType.replace('_', ' ') : 'CORRIDA';
          const isVisible = currentFilter === 'TODOS' || event.eventType === currentFilter;

          return (
            <div 
              class={`event-card group relative bg-surface-alt border-2 border-ink hover:border-accent p-6 flex-col justify-between transition-all duration-300 ${isVisible ? 'flex' : 'hidden'}`}
              data-type={event.eventType}
            >
              
              <div>
                <!-- Mídia ou Tag Superior -->
                {event.bannerUrl ? (
                  <div class="w-full h-40 mb-4 bg-surface-alt border-2 border-ink relative overflow-hidden">
                    <img src={event.bannerUrl} alt={event.title} class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-transform duration-500" />
                    <div class="absolute top-2 left-2 flex items-center justify-between w-[calc(100%-1rem)] font-sans text-[10px] tracking-widest z-10">
                      <span class="bg-surface text-accent border border-accent px-2 py-1 font-bold uppercase">{categoryBadge}</span>
                    </div>
                  </div>
                ) : (
                  <div class="flex items-center justify-between mb-4 font-sans text-[11px] tracking-widest uppercase">
                    <span class="text-accent font-black border-b-2 border-accent pb-0.5">{categoryBadge}</span>
                    <span class="w-2 h-2 bg-accent"></span>
                  </div>
                )}

                <a href={`/eventos/${event.slug}`} class="block group-hover:text-accent transition-colors">
                  <!-- Titulo -->
                  <h3 class="font-heading text-xl font-black text-ink group-hover:text-accent transition-colors duration-200 line-clamp-2 uppercase tracking-tighter">
                    {event.title}
                  </h3>

                  <!-- Descricao Curta -->
                  <p class="text-ink-muted text-sm mt-3 font-sans line-clamp-3 leading-relaxed font-medium">
                    {event.description}
                  </p>
                </a>
              </div>

              <div class="mt-8 pt-6 border-t-2 border-ink-muted/20">
                <div class="grid grid-cols-2 gap-4 mb-6 font-sans text-xs">
                  <div>
                    <span class="text-ink-muted font-bold block uppercase tracking-wider">Data do Evento</span>
                    <span class="text-ink mt-1 block font-black text-sm">{formatDate(event.date)}</span>
                  </div>
                  <div>
                    <span class="text-ink-muted font-bold block uppercase tracking-wider">Valor Inicial</span>
                    <span class="text-ink mt-1 block font-black text-sm">{getStartingPrice(event)}</span>
                  </div>
                </div>

                <!-- CTA -->
                <a
                  href={`/eventos/${event.slug}`}
                  class="block w-full text-center bg-ink border-2 border-ink hover:border-accent hover:bg-accent text-surface font-sans font-bold text-xs uppercase py-3 tracking-widest transition-all duration-200"
                >
                  Ver Detalhes
                </a>
              </div>
            </div>
          );
        })}
      </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const eventCards = document.querySelectorAll('.event-card');
      const emptyState = document.getElementById('empty-state');
      
      const activeClasses = ['bg-accent', 'text-surface', 'border-accent'];
      const inactiveClasses = ['border-ink-muted/30', 'text-ink-muted'];
      const hoverClasses = ['hover:text-ink', 'hover:border-ink'];

      function updateDOM(filterType: string) {
        // Atualizar botoes
        filterBtns.forEach(btn => {
          if ((btn as HTMLElement).dataset.filter === filterType) {
            btn.classList.add(...activeClasses);
            btn.classList.remove(...inactiveClasses, ...hoverClasses);
          } else {
            btn.classList.remove(...activeClasses);
            btn.classList.add(...inactiveClasses, ...hoverClasses);
          }
        });
        
        // Filtrar cards
        let visibleCount = 0;
        eventCards.forEach(card => {
          if (filterType === 'TODOS' || (card as HTMLElement).dataset.type === filterType) {
            card.classList.remove('hidden');
            card.classList.add('flex');
            visibleCount++;
          } else {
            card.classList.remove('flex');
            card.classList.add('hidden');
          }
        });
        
        // Estado vazio
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
            emptyState.classList.add('block');
          } else {
            emptyState.classList.remove('block');
            emptyState.classList.add('hidden');
          }
        }
        
        // Atualizar URL (sem reload)
        const url = new URL(window.location.href);
        if (filterType === 'TODOS') {
          url.searchParams.delete('type');
        } else {
          url.searchParams.set('type', filterType);
        }
        window.history.replaceState({}, '', url);
      }

      function applyFilter(filterType: string) {
        // Se a API de View Transitions for suportada, a transição da altura e dos cards será animada suavemente
        if (!document.startViewTransition) {
          updateDOM(filterType);
          return;
        }
        
        document.startViewTransition(() => {
          updateDOM(filterType);
        });
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const filter = (btn as HTMLElement).dataset.filter;
          if (filter) applyFilter(filter);
        });
      });
    });
  </script>
</BaseLayout>
