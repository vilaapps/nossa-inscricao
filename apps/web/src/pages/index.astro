---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

const url = new URL(Astro.request.url);
const currentFilter = url.searchParams.get('type') || 'TODOS';

// Filtro
const whereClause: any = { 
  status: 'PUBLISHED',
  date: { gt: new Date() } // Oculta eventos que já passaram
};

// Buscar eventos (traz todos para filtrar no cliente)
const events = await prisma.event.findMany({
  where: whereClause,
  include: {
    batches: {
      where: { active: true },
    },
    categories: true,
    _count: {
      select: {
        registrations: {
          where: {
            OR: [
              { paymentStatus: 'PAID' },
              { status: 'CONFIRMED' },
            ],
          },
        },
      },
    },
  },
  orderBy: { date: 'asc' },
});

await prisma.$disconnect();

// Calcular indicadores dinâmicos
const totalSlots = events.reduce((sum: number, e: any) => sum + e.availableSlots, 0);
const filledSlots = events.reduce((sum: number, e: any) => sum + e._count.registrations, 0);
const fillRate = totalSlots > 0 ? Math.round((filledSlots / totalSlots) * 100) : 0;

// Formatador de data em Portugues
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
};

// Obter preco inicial (menor preco de lote ativo)
const getStartingPrice = (event: any) => {
  const activeBatches = event.batches.filter((b: any) => b.active);
  if (activeBatches.length === 0) return 'Sob Consulta';
  const minPrice = Math.min(...activeBatches.map((b: any) => Number(b.price)));
  return new Intl.NumberFormat('pt-BR', {
    style: 'currency',
    currency: 'BRL',
  }).format(minPrice);
};
---

<BaseLayout title="Eventos Esportivos Ativos">
  <!-- Hero Section Brutalist / Minimal Tech -->
  <section class="relative bg-[#08090c] border-b border-zinc-900 py-20 px-6 overflow-hidden">
    <!-- Linhas horizontais de grade HUD -->
    <div class="absolute inset-0 opacity-5 pointer-events-none">
      <div class="w-full h-full bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:40px_40px]"></div>
    </div>
    
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col items-start">
      <!-- Tag superior -->
      <div class="flex items-center gap-2 mb-6 text-[10px] font-mono uppercase tracking-widest text-emerald-400">
        <span class="w-1.5 h-1.5 bg-emerald-500 animate-pulse"></span>
        Status do Sistema: Operacional
      </div>

      <!-- Headline brutalista massivo -->
      <h1 class="font-heading text-5xl md:text-8xl font-black uppercase tracking-tight text-white mb-6 leading-none max-w-5xl">
        INSCREVA-SE<br/>
        <span class="text-zinc-600">E SUPERE OS</span><br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-blue-500">LIMITES.</span>
      </h1>

      <!-- Subtitulo assimetrico e curto -->
      <p class="text-zinc-400 font-sans text-base md:text-lg max-w-xl mb-8 leading-relaxed">
        Inscrição rápida e segura para corridas, duatlo, triatlo, ultra trail, mountain bike, aventuras, etc.
      </p>

      <!-- Stats do HUD na lateral inferior -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 border-t border-zinc-800 pt-8 w-full max-w-3xl font-mono">
        <div>
          <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Eventos Ativos</div>
          <div class="text-2xl font-bold text-white mt-1">{events.length}</div>
        </div>
        <div>
          <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Vagas Preenchidas</div>
          <div class="text-2xl font-bold text-white mt-1">{fillRate}%</div>
        </div>
        <div>
          <div class="text-[10px] text-zinc-500 uppercase tracking-wider">Atletas Inscritos</div>
          <div class="text-2xl font-bold text-white mt-1">{filledSlots}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtro & Listagem de Eventos -->
  <section class="max-w-7xl mx-auto px-6 py-16 flex-grow">
    <!-- Header da Secao -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-zinc-800 pb-6 mb-12 gap-4">
      <div>
        <h2 class="font-heading text-2xl font-bold uppercase tracking-wider text-white">Eventos Disponíveis</h2>
        <p class="text-zinc-500 text-xs mt-1">Selecione uma competição e garanta seu lote com segurança.</p>
      </div>

      <!-- Barra de Filtro Estatica (Visual HUD) -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0" id="filter-container">
        <button data-filter="TODOS" class={`${currentFilter === 'TODOS' ? 'bg-emerald-500/10 border-emerald-500 text-emerald-400' : 'border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700'} filter-btn border text-[10px] font-mono uppercase px-3 py-1.5 tracking-wider transition-all duration-200 cursor-pointer`}>
          Todos
        </button>
        <button data-filter="CORRIDA" class={`${currentFilter === 'CORRIDA' ? 'bg-emerald-500/10 border-emerald-500 text-emerald-400' : 'border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700'} filter-btn border text-[10px] font-mono uppercase px-3 py-1.5 tracking-wider transition-all duration-200 cursor-pointer`}>
          Corrida
        </button>
        <button data-filter="CICLISMO" class={`${currentFilter === 'CICLISMO' ? 'bg-emerald-500/10 border-emerald-500 text-emerald-400' : 'border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700'} filter-btn border text-[10px] font-mono uppercase px-3 py-1.5 tracking-wider transition-all duration-200 cursor-pointer`}>
          Ciclismo
        </button>
        <button data-filter="ULTRA_TRAIL" class={`${currentFilter === 'ULTRA_TRAIL' ? 'bg-emerald-500/10 border-emerald-500 text-emerald-400' : 'border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700'} filter-btn border text-[10px] font-mono uppercase px-3 py-1.5 tracking-wider transition-all duration-200 cursor-pointer`}>
          Ultra Trail
        </button>
        <button data-filter="TRIATHLON" class={`${currentFilter === 'TRIATHLON' ? 'bg-emerald-500/10 border-emerald-500 text-emerald-400' : 'border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700'} filter-btn border text-[10px] font-mono uppercase px-3 py-1.5 tracking-wider transition-all duration-200 cursor-pointer`}>
          Triathlon
        </button>
      </div>
    </div>

    <!-- Grid de Eventos -->
    <div id="empty-state" class={`border border-dashed border-zinc-800 p-12 text-center text-zinc-500 font-mono ${events.length > 0 && events.some(e => currentFilter === 'TODOS' || e.eventType === currentFilter) ? 'hidden' : 'block'}`}>
      NENHUM EVENTO ENCONTRADO PARA O FILTRO SELECIONADO.
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="events-grid">
        {events.map((event) => {
          // Remover lógica frágil e usar o campo real do banco (Substituir underscores por espaço para UI)
          const categoryBadge = event.eventType ? event.eventType.replace('_', ' ') : 'CORRIDA';
          const isVisible = currentFilter === 'TODOS' || event.eventType === currentFilter;

          return (
            <div 
              class={`event-card group relative bg-[#15171f] border border-zinc-800 hover:border-emerald-500/40 p-6 flex-col justify-between transition-all duration-300 ${isVisible ? 'flex' : 'hidden'}`}
              data-type={event.eventType}
            >
              
              <div>
                <!-- Mídia ou Tag Superior -->
                {event.bannerUrl ? (
                  <div class="w-full h-32 mb-4 bg-zinc-900 border border-zinc-800 relative overflow-hidden">
                    <img src={event.bannerUrl} alt={event.title} class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500" />
                    <div class="absolute top-2 left-2 flex items-center justify-between w-[calc(100%-1rem)] font-mono text-[9px] tracking-widest z-10">
                      <span class="bg-black/60 backdrop-blur-sm text-emerald-400 px-2 py-1 font-bold">{categoryBadge}</span>
                    </div>
                  </div>
                ) : (
                  <div class="flex items-center justify-between mb-4 font-mono text-[10px] tracking-widest">
                    <span class="text-emerald-400 font-bold">{categoryBadge}</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  </div>
                )}

                <a href={`/eventos/${event.slug}`} class="block group-hover:text-emerald-400 transition-colors">
                  <!-- Titulo -->
                  <h3 class="font-heading text-lg font-bold text-white group-hover:text-emerald-400 transition-colors duration-200 line-clamp-2 uppercase">
                    {event.title}
                  </h3>

                  <!-- Descricao Curta -->
                  <p class="text-zinc-500 text-sm mt-3 font-sans line-clamp-3 leading-relaxed">
                    {event.description}
                  </p>
                </a>
              </div>

              <div class="mt-8 pt-6 border-t border-zinc-800/60">
                <div class="grid grid-cols-2 gap-4 mb-6 font-mono text-[11px]">
                  <div>
                    <span class="text-zinc-500 block uppercase">Data do Evento</span>
                    <span class="text-zinc-300 mt-0.5 block">{formatDate(event.date)}</span>
                  </div>
                  <div>
                    <span class="text-zinc-500 block uppercase">Valor Inicial</span>
                    <span class="text-zinc-300 mt-0.5 block font-semibold">{getStartingPrice(event)}</span>
                  </div>
                </div>

                <!-- CTA -->
                <a
                  href={`/eventos/${event.slug}`}
                  class="block w-full text-center bg-zinc-900 border border-zinc-800 hover:border-emerald-500 hover:bg-emerald-500/10 text-white font-mono text-xs uppercase py-3 tracking-widest font-semibold transition-all duration-200"
                >
                  Ver Detalhes
                </a>
              </div>
            </div>
          );
        })}
      </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const eventCards = document.querySelectorAll('.event-card');
      const emptyState = document.getElementById('empty-state');
      
      const activeClasses = ['bg-emerald-500/10', 'border-emerald-500', 'text-emerald-400'];
      const inactiveClasses = ['border-zinc-800', 'text-zinc-400'];
      const hoverClasses = ['hover:text-white', 'hover:border-zinc-700'];

      function updateDOM(filterType: string) {
        // Atualizar botoes
        filterBtns.forEach(btn => {
          if ((btn as HTMLElement).dataset.filter === filterType) {
            btn.classList.add(...activeClasses);
            btn.classList.remove(...inactiveClasses, ...hoverClasses);
          } else {
            btn.classList.remove(...activeClasses);
            btn.classList.add(...inactiveClasses, ...hoverClasses);
          }
        });
        
        // Filtrar cards
        let visibleCount = 0;
        eventCards.forEach(card => {
          if (filterType === 'TODOS' || (card as HTMLElement).dataset.type === filterType) {
            card.classList.remove('hidden');
            card.classList.add('flex');
            visibleCount++;
          } else {
            card.classList.remove('flex');
            card.classList.add('hidden');
          }
        });
        
        // Estado vazio
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
            emptyState.classList.add('block');
          } else {
            emptyState.classList.remove('block');
            emptyState.classList.add('hidden');
          }
        }
        
        // Atualizar URL (sem reload)
        const url = new URL(window.location.href);
        if (filterType === 'TODOS') {
          url.searchParams.delete('type');
        } else {
          url.searchParams.set('type', filterType);
        }
        window.history.replaceState({}, '', url);
      }

      function applyFilter(filterType: string) {
        // Se a API de View Transitions for suportada, a transição da altura e dos cards será animada suavemente
        if (!document.startViewTransition) {
          updateDOM(filterType);
          return;
        }
        
        document.startViewTransition(() => {
          updateDOM(filterType);
        });
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const filter = (btn as HTMLElement).dataset.filter;
          if (filter) applyFilter(filter);
        });
      });
    });
  </script>
</BaseLayout>
