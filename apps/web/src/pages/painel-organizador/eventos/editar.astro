---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import EditEventForm from '../../../components/react/EditEventForm';

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

// Validar role de organizador no banco de dados local
const user = await prisma.user.findUnique({
  where: { id: userId },
});

if (!user || (user.role !== 'ORGANIZER' && user.role !== 'ADMIN')) {
  await prisma.$disconnect();
  return Astro.redirect('/painel-organizador');
}

// Obter ID do evento a ser editado via query parameter
const url = new URL(Astro.request.url);
const eventId = url.searchParams.get('id');

if (!eventId) {
  await prisma.$disconnect();
  return Astro.redirect('/painel-organizador');
}

// Buscar evento com categorias e lotes
const event = await prisma.event.findUnique({
  where: { id: eventId },
  include: {
    categories: true,
    batches: true,
  },
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/painel-organizador');
}

// Identificar super admin
const isAdmin = user.role === 'ADMIN' || user.email === 'nossainscricao@gmail.com';

// Validar se o evento pertence à organização do usuário (a não ser que seja admin)
if (!isAdmin && user.role === 'ORGANIZER' && event.tenantId !== user.tenantId) {
  return Astro.redirect('/painel-organizador');
}

// Validar se o evento está em DRAFT ou REJECTED (se não for admin)
if (!isAdmin && event.status !== 'DRAFT' && event.status !== 'REJECTED') {
  return Astro.redirect('/painel-organizador');
}

// Serializar Prisma Decimals para string
const serializedEvent = {
  ...event,
  categories: event.categories.map((cat: any) => ({
    ...cat,
    price: cat.price ? cat.price.toString() : '0'
  })),
  batches: event.batches.map((bat: any) => ({
    ...bat,
    price: bat.price ? bat.price.toString() : '0'
  }))
};
---

<BaseLayout title={`Editar Evento — ${event.title}`}>
  <!-- Cabeçalho HUD Simplificado -->
  <section class="bg-surface border-b border-ink-muted/20 py-8 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-start font-mono text-xs tracking-widest text-ink-muted gap-2">
      <a href={isAdmin ? "/admin/dashboard" : "/painel-organizador"} class="hover:text-accent transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Voltar para {isAdmin ? "o Painel Geral Admin" : "o Dashboard"}
      </a>
      <div class="flex items-center gap-4">
        <span class="text-accent font-bold">GERENCIAMENTO DE COMPETIÇÕES</span>
        <span class="text-ink-muted/40">|</span>
        <span class="text-ink font-semibold">
          {isAdmin ? `EDIÇÃO DE EVENTO (ADMIN - ${event.status})` : 'EDITAR EVENTO (RASCUNHO/REPROVADO)'}
        </span>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
    <EditEventForm client:load event={serializedEvent} isAdmin={isAdmin} />
  </section>
</BaseLayout>
