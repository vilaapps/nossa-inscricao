---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import NewEventForm from '../../../components/react/NewEventForm';

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

// Validar role de organizador no banco de dados local
const user = await prisma.user.findUnique({
  where: { id: userId },
});

await prisma.$disconnect();

if (!user || (user.role !== 'ORGANIZER' && user.role !== 'ADMIN')) {
  return Astro.redirect('/painel-organizador');
}
---

<BaseLayout title="Criar Novo — Painel Organizador">
  <!-- Cabeçalho HUD Simplificado -->
  <section class="bg-surface border-b border-ink-muted/20 py-8 px-6">
    <div class="max-w-6xl mx-auto flex flex-col items-start font-mono text-xs tracking-widest text-ink-muted gap-2">
      <a href="/painel-organizador" class="hover:text-accent transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Voltar para o Dashboard
      </a>
      <div class="flex items-center gap-4">
        <span class="text-accent font-bold">GERENCIAMENTO DE COMPETIÇÕES</span>
        <span class="text-ink-muted/40">|</span>
        <span class="text-ink font-semibold">CADASTRAR NOVO EVENTO</span>
      </div>
    </div>
  </section>

  <!-- Área do Formulário -->
  <section class="max-w-6xl mx-auto px-6 py-12 flex-grow w-full">
    <NewEventForm client:load />
  </section>
</BaseLayout>
