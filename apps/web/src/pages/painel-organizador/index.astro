---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

// Buscar usuario no banco local para verificar role e tenant
let user = await prisma.user.findUnique({
  where: { id: userId },
});

// Se o usuário não existir localmente, criamos o cadastro inicial como PARTICIPANT
if (!user) {
  const clerkUser = await Astro.locals.currentUser();
  if (!clerkUser) {
    await prisma.$disconnect();
    return Astro.redirect('/');
  }
  const email = clerkUser.emailAddresses[0]?.emailAddress || '';
  const name = clerkUser.firstName ? `${clerkUser.firstName} ${clerkUser.lastName || ''}`.trim() : '';
  
  const isSuperAdmin = email === 'nossainscricao@gmail.com';
  
  if (isSuperAdmin) {
    await prisma.tenant.upsert({
      where: { id: 'tenant-platform' },
      update: {},
      create: {
        id: 'tenant-platform',
        name: 'Plataforma Nossa Inscrição',
        commissionRate: 10.00,
      }
    });

    user = await prisma.user.create({
      data: {
        id: userId,
        email,
        name,
        role: 'ADMIN',
        tenantId: 'tenant-platform',
      }
    });
  } else {
    user = await prisma.user.create({
      data: {
        id: userId,
        email,
        name,
        role: 'PARTICIPANT',
      }
    });
  }
}

// Se for ADMIN, redirecionar para o painel admin
if (user.role === 'ADMIN') {
  await prisma.$disconnect();
  return Astro.redirect('/admin/dashboard');
}

const isOrganizer = user.role === 'ORGANIZER';
const isParticipant = user.role === 'PARTICIPANT';

let tenant = null;
let events: any[] = [];

// --- Dados do Organizador ---
let totalRevenue = 0;
let totalRegistrationsCount = 0;
let confirmedRegistrationsCount = 0;
let pendingRegistrationsCount = 0;
let eventStats: any[] = [];

if (isOrganizer) {
  const tenantId = user.tenantId || 'tenant-1';
  tenant = await prisma.tenant.findUnique({
    where: { id: tenantId },
  });

  events = await prisma.event.findMany({
    where: { tenantId },
    include: {
      categories: true,
      batches: true,
      registrations: {
        include: {
          payment: true,
        }
      }
    }
  });

  const feeRate = Number(tenant?.commissionRate || 10) / 100;
  
  eventStats = events.map(event => {
    let eventRevenue = 0;
    let eventConfirmed = 0;
    let eventPending = 0;
    
    event.registrations.forEach((reg: any) => {
      totalRegistrationsCount++;
      if (reg.paymentStatus === 'PAID' || reg.status === 'CONFIRMED') {
        const metadataObj = reg.metadata ? (typeof reg.metadata === 'string' ? JSON.parse(reg.metadata) : reg.metadata) : {};
        const organizerShare = metadataObj.subtotal !== undefined
          ? Number(metadataObj.subtotal)
          : (Number(reg.amountPaid) / (1 + feeRate));
        eventRevenue += organizerShare;
        eventConfirmed++;
        confirmedRegistrationsCount++;
      } else if (reg.status === 'PENDING' || reg.status === 'QUEUED') {
        eventPending++;
        pendingRegistrationsCount++;
      }
    });

    totalRevenue += eventRevenue;

    const totalSlots = event.availableSlots;
    const occupancyRate = totalSlots > 0 ? (eventConfirmed / totalSlots) * 100 : 0;

    return {
      id: event.id,
      title: event.title,
      slug: event.slug,
      status: event.status,
      rejectionReason: event.rejectionReason,
      revenue: eventRevenue,
      confirmed: eventConfirmed,
      pending: eventPending,
      slots: totalSlots,
      occupancy: occupancyRate,
      date: event.date,
    };
  });
}

await prisma.$disconnect();

// Taxa de Conversão global (Organizador)
const conversionRate = totalRegistrationsCount > 0 
  ? (confirmedRegistrationsCount / totalRegistrationsCount) * 100 
  : 0;

// Ocupação Global (Organizador)
const totalSlotsGlobal = events.reduce((sum: number, e: any) => sum + e.availableSlots, 0);
const occupancyGlobal = totalSlotsGlobal > 0 
  ? (confirmedRegistrationsCount / totalSlotsGlobal) * 100 
  : 0;

// ROSCA (Donut Chart) da Ocupação Global
const r = 40;
const circumference = 2 * Math.PI * r; // ~251.327
const dashoffset = circumference - (occupancyGlobal / 100) * circumference;

// GRÁFICO DE BARRAS do Faturamento por Evento
const maxRevenue = Math.max(...eventStats.map(e => e.revenue), 100);
const barGraphHeight = 160;
---

<BaseLayout title={isParticipant ? "Seja um Organizador — Onboarding" : "Painel Organizador — Dashboard"}>
  
  {isParticipant && (
    <!-- TELA DE ONBOARDING: PARTICIPANTE -> ORGANIZADOR -->
    <section class="bg-surface border-b border-ink-muted/20 py-12 px-6">
      <div class="max-w-xl mx-auto font-mono text-xs tracking-widest text-ink-muted text-center">
        <span class="text-emerald-600 dark:text-emerald-400 font-bold">PORTAL DE ORGANIZADORES</span>
        <span class="text-ink-muted/40 mx-2">|</span>
        <span class="text-ink font-semibold">CADASTRO DE PARCEIRO</span>
      </div>
    </section>

    <section class="max-w-xl mx-auto px-6 py-20 flex-grow w-full font-mono">
      <div class="bg-surface-alt border border-ink-muted/20 p-8 relative shadow-sm">
        <div class="absolute top-0 right-0 w-12 h-12 border-t border-r border-ink-muted/20 pointer-events-none"></div>
        
        <div class="mb-8">
          <div class="text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-400 mb-2 flex items-center gap-1.5 justify-center">
            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
            Traga seu evento para o SyncFlow
          </div>
          <h2 class="font-heading text-2xl font-extrabold text-ink uppercase tracking-wider text-center">Seja um Organizador</h2>
          <p class="text-ink-muted text-xs mt-3 font-sans text-center leading-relaxed">
            Cadastre os dados de sua organização ou assessoria abaixo para liberar a criação de competições e venda de inscrições. Você continuará podendo participar de eventos como atleta com a mesma conta.
          </p>
        </div>

        <form id="onboarding-form" class="space-y-6 text-xs text-ink-muted">
          <div class="space-y-2">
            <label for="orgName" class="text-xs uppercase block tracking-wider font-bold text-ink">Nome da Organização / Assessoria</label>
            <input
              type="text"
              id="orgName"
              required
              placeholder="EX: CORRIDA BRASIL ORGANIZAÇÕES"
              class="w-full bg-surface border border-ink-muted/30 text-ink px-4 py-3 outline-none focus:border-accent transition-colors uppercase placeholder:text-ink-muted/40"
            />
          </div>

          <div class="space-y-2">
            <label for="cpfCnpj" class="text-xs uppercase block tracking-wider font-bold text-ink">CPF ou CNPJ</label>
            <input
              type="text"
              id="cpfCnpj"
              required
              placeholder="EX: 00.000.000/0001-00"
              class="w-full bg-surface border border-ink-muted/30 text-ink px-4 py-3 outline-none focus:border-accent transition-colors uppercase placeholder:text-ink-muted/40"
            />
          </div>

          <div id="error-message" class="bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 p-4 hidden uppercase"></div>
          <div id="success-message" class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 p-4 hidden uppercase flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping"></span>
            Cadastro concluído! Redirecionando...
          </div>

          <button
            type="submit"
            class="w-full bg-emerald-500 hover:bg-emerald-600 text-black text-xs uppercase py-4 tracking-widest font-extrabold transition-all duration-200 cursor-pointer"
          >
            CONFIRMAR PARCERIA
          </button>
        </form>
      </div>
    </section>

    <script is:inline define:vars={{ userEmail: user.email, userName: user.name }}>
      const form = document.getElementById('onboarding-form');
      const errorDiv = document.getElementById('error-message');
      const successDiv = document.getElementById('success-message');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorDiv.classList.add('hidden');
        successDiv.classList.add('hidden');

        const orgName = document.getElementById('orgName').value;
        const cpfCnpj = document.getElementById('cpfCnpj').value;

        try {
          const response = await fetch('/api/admin/tornar-organizador', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              organizationName: orgName,
              cpfCnpj,
              email: userEmail,
              name: userName
            })
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || 'Erro ao realizar o onboarding.');
          }

          successDiv.classList.remove('hidden');
          setTimeout(() => {
            window.location.reload();
          }, 1500);

        } catch (err) {
          errorDiv.textContent = '✕ ' + err.message;
          errorDiv.classList.remove('hidden');
        }
      });
    </script>
  )}

  {isOrganizer && (
    <!-- TELA DO ORGANIZADOR DA COMPETIÇÃO (TENANT ESPECÍFICO) -->
    <!-- Top Title HUD -->
    <section class="bg-surface border-b border-ink-muted/20 py-12 px-6">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6 font-mono">
        <div>
          <div class="text-xs uppercase tracking-widest text-accent mb-2 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-accent rounded-full animate-pulse"></span>
            Painel Organizador // {tenant?.name}
          </div>
          <h1 class="font-heading text-3xl font-extrabold uppercase text-ink tracking-wider">
            Dashboard Geral
          </h1>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/painel-organizador/eventos/novo"
            class="bg-emerald-500 hover:bg-emerald-600 text-black text-xs uppercase px-5 py-3 tracking-widest font-extrabold transition-all duration-200"
          >
            + Novo Evento
          </a>
        </div>
      </div>
    </section>

    <!-- Métricas Consolidadas -->
    <section class="max-w-7xl mx-auto px-6 py-12 space-y-12 flex-grow w-full">
      <!-- Grid de Métricas HUD -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 font-mono">
        <div class="bg-surface-alt border border-ink-muted/20 p-5 relative shadow-sm">
          <div class="text-xs text-ink-muted uppercase tracking-wider font-semibold">Receita do Organizador</div>
          <div class="text-3xl font-bold text-ink mt-2">
            {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(totalRevenue)}
          </div>
          <div class="text-[11px] text-emerald-600 dark:text-emerald-400 uppercase mt-2">Repasse integral (Taxa administrativa transferida ao participante)</div>
          <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-ink-muted/20"></div>
        </div>

        <div class="bg-surface-alt border border-ink-muted/20 p-5 relative shadow-sm">
          <div class="text-xs text-ink-muted uppercase tracking-wider font-semibold">Total de Inscrições</div>
          <div class="text-3xl font-bold text-ink mt-2">{totalRegistrationsCount}</div>
          <div class="text-[11px] text-ink-muted uppercase mt-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">{confirmedRegistrationsCount}</span> pagas // <span class="text-amber-500 font-bold">{pendingRegistrationsCount}</span> pendentes
          </div>
          <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-ink-muted/20"></div>
        </div>

        <div class="bg-surface-alt border border-ink-muted/20 p-5 relative shadow-sm">
          <div class="text-xs text-ink-muted uppercase tracking-wider font-semibold">Taxa de Conversão</div>
          <div class="text-3xl font-bold text-emerald-600 dark:text-emerald-400 mt-2">
            {conversionRate.toFixed(1)}%
          </div>
          <div class="text-[11px] text-ink-muted uppercase mt-2">Porcentagem de inscrições pagas</div>
          <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-ink-muted/20"></div>
        </div>

        <div class="bg-surface-alt border border-ink-muted/20 p-5 relative shadow-sm">
          <div class="text-xs text-ink-muted uppercase tracking-wider font-semibold">Vagas Ocupadas</div>
          <div class="text-3xl font-bold text-blue-600 dark:text-blue-400 mt-2">
            {occupancyGlobal.toFixed(1)}%
          </div>
          <div class="text-[11px] text-ink-muted uppercase mt-2">
            {confirmedRegistrationsCount} vagas preenchidas de {totalSlotsGlobal}
          </div>
          <div class="absolute top-0 right-0 w-3 h-3 border-t border-r border-ink-muted/20"></div>
        </div>
      </div>

      <!-- Gráficos Gerados em SVG (Faturamento e Ocupação) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Gráfico de Rosca SVG: Ocupação das Vagas -->
        <div class="bg-surface-alt border border-ink-muted/20 p-6 flex flex-col justify-between h-[340px] shadow-sm">
          <div class="font-mono">
            <h3 class="text-xs font-bold text-ink uppercase tracking-wider">Ocupação Global de Vagas</h3>
            <p class="text-ink-muted text-xs uppercase mt-1">Status de reservas em lotes ativos</p>
          </div>

          <div class="relative flex items-center justify-center py-6">
            <svg class="w-36 h-36 transform -rotate-90">
              <!-- Circulo Fundo -->
              <circle
                cx="72"
                cy="72"
                r={r}
                class="stroke-zinc-200 dark:stroke-zinc-800"
                stroke-width="12"
                fill="transparent"
              />
              <!-- Circulo Preenchimento -->
              <circle
                cx="72"
                cy="72"
                r={r}
                class="stroke-blue-500 transition-all duration-1000 ease-out"
                stroke-width="12"
                fill="transparent"
                stroke-dasharray={circumference}
                stroke-dashoffset={dashoffset}
                stroke-linecap="square"
              />
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center font-mono">
              <span class="text-2xl font-bold text-ink">{occupancyGlobal.toFixed(0)}%</span>
              <span class="text-[11px] text-ink-muted uppercase tracking-wider">Vagas Preenchidas</span>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs font-mono border-t border-ink-muted/20 pt-4">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              <span class="text-ink font-medium">Pagas: {confirmedRegistrationsCount}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 bg-zinc-300 dark:bg-zinc-700 rounded-full"></span>
              <span class="text-ink-muted">Restantes: {Math.max(0, totalSlotsGlobal - confirmedRegistrationsCount)}</span>
            </div>
          </div>
        </div>

        <!-- Gráfico de Barras SVG: Faturamento por Evento -->
        <div class="bg-surface-alt border border-ink-muted/20 p-6 flex flex-col justify-between h-[340px] lg:col-span-2 shadow-sm">
          <div class="font-mono">
            <h3 class="text-xs font-bold text-ink uppercase tracking-wider">Faturamento Líquido por Evento</h3>
            <p class="text-ink-muted text-xs uppercase mt-1">Valores expressos em moeda nacional</p>
          </div>

          <div class="relative w-full h-[180px] flex items-end pt-4 font-mono">
            {eventStats.length === 0 ? (
              <div class="w-full text-center text-ink-muted text-xs py-8 uppercase">Nenhum evento registrado</div>
            ) : (
              <div class="w-full h-full flex items-end justify-around border-b border-ink-muted/20 pb-2">
                {eventStats.map((item) => {
                  const barHeight = (item.revenue / maxRevenue) * barGraphHeight;
                  return (
                    <div class="flex flex-col items-center w-full group relative">
                      <div class="absolute -top-8 bg-surface-alt border border-ink-muted/20 text-emerald-600 dark:text-emerald-400 px-2.5 py-1 text-[11px] rounded-sm hidden group-hover:block transition-all shadow-xl font-bold">
                        {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 }).format(item.revenue)}
                      </div>
                      
                      <div
                        style={`height: ${Math.max(4, barHeight)}px;`}
                        class="w-12 bg-emerald-500/20 border-t-2 border-emerald-500 hover:bg-emerald-500/30 transition-all duration-300 relative"
                      ></div>
                      
                      <span class="text-[11px] text-ink-muted uppercase mt-2 max-w-[80px] truncate text-center block font-semibold">
                        {item.title.split(' ')[0]} {item.title.split(' ')[1] || ''}
                      </span>
                    </div>
                  );
                })}
              </div>
            )}
          </div>

          <div class="text-[11px] text-ink-muted uppercase font-mono border-t border-ink-muted/20 pt-4">
            * Passe o cursor do mouse sobre a coluna correspondente para visualizar o faturamento líquido.
          </div>
        </div>
      </div>

      <!-- Lista Detalhada de Eventos com Ocupação HUD -->
      <div class="space-y-6">
        <h3 class="font-heading text-lg font-bold text-ink uppercase tracking-wider border-b border-ink-muted/20 pb-4">
          Controle de Competições
        </h3>

        <div class="border border-ink-muted/20 overflow-x-auto shadow-sm">
          <table class="w-full text-left font-mono text-xs border-collapse">
            <thead>
              <tr class="bg-surface text-ink-muted border-b border-ink-muted/20 text-xs uppercase tracking-wider">
                <th class="p-4">Competição</th>
                <th class="p-4">Status</th>
                <th class="p-4">Data Prova</th>
                <th class="p-4 text-center">Inscrições (Pagas / Total / Disp)</th>
                <th class="p-4 text-center">Faturamento Líquido</th>
                <th class="p-4">Progresso de Vagas</th>
                <th class="p-4 text-center">Ações</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-muted/10 bg-surface-alt">
              {eventStats.map((item) => (
                <tr class="hover:bg-surface/50 transition-colors">
                  <td class="p-4 font-bold text-ink uppercase">{item.title}</td>
                  <td class="p-4">
                    {item.status === 'DRAFT' && (
                      <span class="bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-[11px] uppercase px-2.5 py-1 font-bold tracking-wider block w-fit">
                        Aguardando Aprovação
                      </span>
                    )}
                    {item.status === 'PUBLISHED' && (
                      <span class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-[11px] uppercase px-2.5 py-1 font-bold tracking-wider block w-fit">
                        Publicado
                      </span>
                    )}
                    {item.status === 'REJECTED' && (
                      <div>
                        <span class="bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 text-[11px] uppercase px-2.5 py-1 font-bold tracking-wider block w-fit">
                          Reprovado
                        </span>
                        <p class="text-[11px] text-ink-muted mt-1 uppercase max-w-[150px] truncate" title={item.rejectionReason}>
                          Motivo: {item.rejectionReason}
                        </p>
                      </div>
                    )}
                    {item.status === 'ARCHIVED' && (
                      <span class="bg-surface border border-ink-muted/30 text-ink-muted text-[11px] uppercase px-2.5 py-1 font-bold tracking-wider block w-fit">
                        Arquivado
                      </span>
                    )}
                  </td>
                  <td class="p-4 text-ink-muted font-medium">
                    {new Date(item.date).toLocaleDateString('pt-BR')}
                  </td>
                  <td class="p-4 text-center font-mono text-xs">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold">{item.confirmed}</span>
                    <span class="text-ink-muted/40 mx-0.5">/</span>
                    <span class="text-ink">{item.confirmed + item.pending}</span>
                    <span class="text-ink-muted/40 mx-0.5">/</span>
                    <span class="text-blue-600 dark:text-blue-400 font-bold">{Math.max(0, item.slots - item.confirmed)}</span>
                  </td>
                  <td class="p-4 text-center text-emerald-600 dark:text-emerald-400 font-bold">
                    {new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(item.revenue)}
                  </td>
                  <td class="p-4 w-64">
                    <div class="flex items-center gap-3">
                      <div class="flex-grow h-2 bg-surface border border-ink-muted/20 rounded-none overflow-hidden relative">
                        <div
                          style={`width: ${item.occupancy}%`}
                          class="h-full bg-blue-500 transition-all duration-500"
                        ></div>
                      </div>
                      <span class="text-xs text-ink-muted w-8">{item.occupancy.toFixed(0)}%</span>
                    </div>
                  </td>
                  <td class="p-4 text-center">
                    <div class="flex items-center justify-center gap-2">
                      {(item.status === 'DRAFT' || item.status === 'REJECTED') && (
                        <a
                          href={`/painel-organizador/eventos/editar?id=${item.id}`}
                          class="border border-ink-muted/30 hover:border-ink-muted text-ink-muted hover:text-ink text-xs px-3.5 py-1.5 uppercase font-bold tracking-wider transition-colors"
                        >
                          Editar
                        </a>
                      )}
                      {(item.status === 'PUBLISHED' || item.status === 'ARCHIVED') && (
                        <a
                          href={`/painel-organizador/eventos/visualizar?id=${item.id}`}
                          class="border border-blue-500/30 hover:border-blue-500 text-blue-600 dark:text-blue-400 hover:opacity-80 text-xs px-3.5 py-1.5 uppercase font-bold tracking-wider transition-colors"
                        >
                          Ver
                        </a>
                      )}
                      {item.status === 'REJECTED' && (
                        <button
                          onclick={`arquivarEvento('${item.id}')`}
                          class="border border-amber-500/30 hover:border-amber-500 text-amber-600 dark:text-amber-400 text-xs px-3.5 py-1.5 uppercase font-bold tracking-wider transition-colors cursor-pointer"
                        >
                          Arquivar
                        </button>
                      )}
                      {(item.status === 'DRAFT' || item.status === 'REJECTED' || (item.status === 'PUBLISHED' && item.confirmed === 0 && item.pending === 0)) && (
                        <button
                          onclick={`excluirEvento('${item.id}')`}
                          class="bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 hover:bg-red-500/20 text-xs px-3.5 py-1.5 uppercase font-extrabold tracking-wider transition-colors cursor-pointer"
                        >
                          Excluir
                        </button>
                      )}
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <script is:inline>
    async function excluirEvento(eventId) {
      if (!await window.cyberConfirm('Deseja realmente excluir este evento permanentemente? Esta ação não pode ser desfeita.')) {
        return;
      }

      try {
        const clerk = window.Clerk;
        let headers = {
          'Content-Type': 'application/json',
        };

        if (clerk && clerk.session) {
          const token = await clerk.session.getToken();
          headers['Authorization'] = `Bearer ${token}`;
        }

        const response = await fetch('/api/admin/eventos/excluir', {
          method: 'POST',
          headers,
          body: JSON.stringify({ eventId }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao excluir o evento.');
        }

        await window.cyberAlert('Evento excluído com sucesso!');
        window.location.reload();
      } catch (err) {
        await window.cyberAlert(err.message, 'SYSTEM_ERROR', 'error');
      }
    }

    async function arquivarEvento(eventId) {
      if (!await window.cyberConfirm('Deseja realmente arquivar este evento? Ele será ocultado.')) {
        return;
      }

      try {
        const clerk = window.Clerk;
        let headers = {
          'Content-Type': 'application/json',
        };

        if (clerk && clerk.session) {
          const token = await clerk.session.getToken();
          headers['Authorization'] = `Bearer ${token}`;
        }

        const response = await fetch('/api/admin/eventos/arquivar', {
          method: 'POST',
          headers,
          body: JSON.stringify({ eventId }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Erro ao arquivar o evento.');
        }

        await window.cyberAlert('Evento arquivado com sucesso!');
        window.location.reload();
      } catch (err) {
        await window.cyberAlert(err.message, 'SYSTEM_ERROR', 'error');
      }
    }
  </script>
</BaseLayout>
