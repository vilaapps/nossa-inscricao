---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import RegistrationForm from '../../components/react/RegistrationForm';

const { eventId } = Astro.params;

if (!eventId) {
  return Astro.redirect('/404');
}

const prisma = new PrismaClient();

// Buscar o evento com as categorias, lotes ativos e tenant
const event = await prisma.event.findFirst({
  where: { id: eventId, status: 'PUBLISHED' },
  include: {
    tenant: true,
    categories: true,
    batches: {
      where: { active: true },
    },
  },
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/404');
}

// Taxa administrativa do parceiro (padrão 10%)
const commissionRate = Number(event.tenant?.commissionRate || 10);

// Serializar explicitamente categorias e lotes para garantir integridade na fronteira Astro/React
const serializedCategories = event.categories.map(cat => ({
  id: cat.id,
  name: cat.name,
  gender: cat.gender,
  availableSlots: cat.availableSlots,
}));

const serializedBatches = event.batches.map(batch => ({
  id: batch.id,
  name: batch.name,
  price: batch.price.toString(),
  active: batch.active,
}));
---

<BaseLayout title={`Inscrição — ${event.title}`}>
  <!-- Cabeçalho HUD Simplificado -->
  <section class="bg-surface border-b border-ink-muted/20 py-8 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-start font-mono text-xs tracking-widest text-ink-muted gap-2">
      <a href={`/eventos/${event.slug}`} class="hover:text-accent transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Cancelar e voltar para o evento
      </a>
      <div class="flex items-center gap-4">
        <span class="text-accent font-bold">FLUXO DE RESERVA DE VAGA</span>
        <span class="text-ink-muted">|</span>
        <span class="text-ink font-semibold">{event.title}</span>
      </div>
    </div>
  </section>

  <!-- Área do Formulário Multi-Step -->
  <section class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
    <RegistrationForm
      client:load
      eventId={event.id}
      eventTitle={event.title}
      categories={serializedCategories}
      batches={serializedBatches}
      commissionRate={commissionRate}
    />
  </section>
</BaseLayout>
