---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';
import RegistrationForm from '../../components/react/RegistrationForm';

const { eventId } = Astro.params;

if (!eventId) {
  return Astro.redirect('/404');
}

const prisma = new PrismaClient();

// Buscar o evento com as categorias e lotes ativos
const event = await prisma.event.findFirst({
  where: { id: eventId, status: 'PUBLISHED' },
  include: {
    categories: true,
    batches: {
      where: { active: true },
    },
  },
});

await prisma.$disconnect();

if (!event) {
  return Astro.redirect('/404');
}
---

<BaseLayout title={`Inscrição — ${event.title}`}>
  <!-- Cabeçalho HUD Simplificado -->
  <section class="bg-[#08090c] border-b border-zinc-900 py-8 px-6">
    <div class="max-w-4xl mx-auto flex flex-col items-start font-mono text-[10px] tracking-widest text-zinc-500 gap-2">
      <a href={`/eventos/${event.slug}`} class="hover:text-emerald-400 transition-colors uppercase flex items-center gap-1.5 mb-2">
        &larr; Cancelar e voltar para o evento
      </a>
      <div class="flex items-center gap-4">
        <span class="text-emerald-400 font-bold">FLUXO DE RESERVA DE VAGA</span>
        <span class="text-zinc-700">|</span>
        <span class="text-zinc-400 font-semibold">{event.title}</span>
      </div>
    </div>
  </section>

  <!-- Área do Formulário Multi-Step -->
  <section class="max-w-4xl mx-auto px-6 py-12 flex-grow w-full">
    <RegistrationForm
      client:load
      eventId={event.id}
      eventTitle={event.title}
      categories={event.categories}
      batches={event.batches}
    />
  </section>
</BaseLayout>
