---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PrismaClient } from '@prisma/client';

// Obter sessao do Clerk
const auth = Astro.locals.auth();
const userId = auth.userId;

if (!userId) {
  return Astro.redirect('/');
}

const prisma = new PrismaClient();

// Buscar as inscricoes do usuario logado
const registrations = await prisma.registration.findMany({
  where: { userId },
  include: {
    event: true,
    category: true,
    batch: true,
    payment: true,
  },
  orderBy: { createdAt: 'desc' },
});

await prisma.$disconnect();

// Formatador de data
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('pt-BR', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).format(date);
};

// Formatar moeda
const formatCurrency = (val: number) => {
  return new Intl.NumberFormat('pt-BR', {
    style: 'currency',
    currency: 'BRL',
  }).format(val);
};

// Mapeamento de Cores de Status
const getStatusClasses = (status: string, paymentStatus: string, context: 'ACTIVE' | 'CANCELLED' | 'PAST') => {
  // 1. Contexto de Evento que já passou
  if (context === 'PAST') {
    if (status === 'CONFIRMED' || paymentStatus === 'PAID') {
      return {
        bg: 'bg-blue-500/10 border-blue-500/30 text-blue-600 dark:text-blue-400',
        label: 'Participou',
        indicator: 'bg-blue-500',
      };
    }
    return {
      bg: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-600 dark:text-zinc-400',
      label: 'Não Participou',
      indicator: 'bg-zinc-500',
    };
  }

  // 2. Contexto de Inscrições Canceladas/Expiradas (Evento no futuro)
  if (context === 'CANCELLED') {
    if (status === 'CANCELLED') {
      return {
        bg: 'bg-red-500/10 border-red-500/30 text-red-600 dark:text-red-400',
        label: 'Cancelada',
        indicator: 'bg-red-500',
      };
    }
    return {
      bg: 'bg-zinc-500/10 border-zinc-500/30 text-zinc-600 dark:text-zinc-400',
      label: 'Pagamento Expirado',
      indicator: 'bg-zinc-500',
    };
  }

  // 3. Contexto Vigente
  if (status === 'CONFIRMED' || paymentStatus === 'PAID') {
    return {
      bg: 'bg-emerald-500/10 border-emerald-500/30 text-emerald-600 dark:text-emerald-400',
      label: 'Confirmada & Paga',
      indicator: 'bg-emerald-500',
    };
  }
  return {
    bg: 'bg-amber-500/10 border-amber-500/30 text-amber-600 dark:text-amber-400',
    label: 'Aguardando Pagamento',
    indicator: 'bg-amber-500',
  };
};

const now = new Date();

// Apenas Inscrições válidas para eventos futuros
const activeRegistrations = registrations.filter(r => 
  new Date(r.event.date) > now && 
  r.status !== 'CANCELLED' && 
  r.status !== 'EXPIRED'
);

// Inscrições canceladas ou com pagamento expirado para eventos futuros
const cancelledRegistrations = registrations.filter(r => 
  new Date(r.event.date) > now && 
  (r.status === 'CANCELLED' || r.status === 'EXPIRED')
);

// Eventos que já aconteceram (Histórico do Atleta)
const pastRegistrations = registrations.filter(r => 
  new Date(r.event.date) <= now
);
---

<BaseLayout title="Minhas Inscrições — Painel do Participante">
  <section class="bg-surface border-b border-ink-muted/20 py-12 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-4 font-mono">
      <div>
        <div class="text-xs uppercase tracking-widest text-ink-muted mb-2 font-medium">Painel do Atleta</div>
        <h1 class="font-heading text-3xl font-extrabold uppercase text-ink tracking-wider">
          Minhas Inscrições
        </h1>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-12 flex-grow w-full space-y-16">
    {/* VIGENTES */}
    <div>
      <h2 class="font-heading text-xl md:text-2xl font-bold uppercase text-ink tracking-wider mb-6 border-b border-ink-muted/20 pb-4">
        Inscrições Vigentes
      </h2>
      
      {activeRegistrations.length === 0 ? (
        <div class="border border-dashed border-ink-muted/30 p-12 text-center font-mono text-ink-muted space-y-6">
          <div class="text-sm md:text-base">VOCÊ NÃO POSSUI NENHUMA INSCRIÇÃO ATIVA NO MOMENTO.</div>
          <a
            href="/"
            class="inline-block bg-surface-alt border border-ink-muted/30 hover:border-accent text-ink text-xs md:text-sm uppercase px-8 py-3.5 tracking-widest font-semibold transition-all duration-200"
          >
            Navegar por Eventos
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {activeRegistrations.map((reg) => {
            const statusConfig = getStatusClasses(reg.status, reg.paymentStatus, 'ACTIVE');
            const isPending = reg.status === 'PENDING' || reg.status === 'QUEUED';
            const pixCode = reg.payment?.pixQrCode;

            return (
              <div class="bg-surface-alt border border-ink-muted/20 p-6 md:p-8 flex flex-col justify-between relative group shadow-sm">
                <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-ink-muted/20 pointer-events-none group-hover:border-accent/40 transition-colors"></div>

                <div>
                  <div class="flex items-center justify-between mb-4 font-mono text-xs md:text-sm">
                    <span class="text-ink-muted uppercase font-semibold">Inscrição #{reg.id.substring(0, 8).toUpperCase()}</span>
                    <span class={`flex items-center gap-1.5 px-3 py-1 text-xs font-semibold border ${statusConfig.bg}`}>
                      <span class={`w-2 h-2 rounded-full ${statusConfig.indicator} ${isPending ? 'animate-pulse' : ''}`}></span>
                      {statusConfig.label}
                    </span>
                  </div>

                  <h3 class="font-heading text-xl md:text-2xl font-bold text-ink uppercase tracking-wider mb-3">
                    {reg.event.title}
                  </h3>

                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-5 gap-x-6 my-6 font-mono text-sm">
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Data do Evento</span>
                      <span class="text-ink font-bold block mt-1 text-sm md:text-base">{formatDate(reg.event.date)}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Data Inscrição</span>
                      <span class="text-ink font-medium block mt-1 text-sm md:text-base">{formatDate(reg.createdAt)}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Valor Pago</span>
                      <span class="text-ink font-bold block mt-1 text-base md:text-lg">{formatCurrency(Number(reg.amountPaid))}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Categoria</span>
                      <span class="text-ink font-medium block mt-1 text-sm md:text-base">{reg.category.name}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Lote Adquirido</span>
                      <span class="text-ink font-medium block mt-1 text-sm md:text-base">{reg.batch.name}</span>
                    </div>
                  </div>
                </div>

                {isPending && pixCode && (
                  <div class="border-t border-ink-muted/20 pt-6 mt-4 space-y-4 font-mono text-xs md:text-sm">
                    <div class="bg-surface border border-ink-muted/20 p-5 space-y-4">
                      <div class="flex items-center justify-between text-xs font-semibold">
                        <span class="text-amber-500 dark:text-amber-400 flex items-center gap-1.5 font-bold">
                          <span class="w-2 h-2 bg-amber-500 dark:bg-amber-400 rounded-full animate-ping"></span>
                          PAGAMENTO PIX DISPONÍVEL
                        </span>
                        <span class="text-ink-muted">Gateway: Asaas</span>
                      </div>
                      
                      <div class="w-40 h-40 mx-auto bg-white p-2.5 border border-ink-muted/20 shadow-sm">
                        <img
                          src={`https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(pixCode)}`}
                          alt="QR Code PIX para pagamento"
                          class="w-full h-full object-contain"
                        />
                      </div>

                      <div class="space-y-1.5">
                        <span class="text-xs text-ink-muted uppercase font-semibold">PIX Copia e Cola</span>
                        <div class="flex gap-2">
                          <input
                            type="text"
                            readonly
                            value={pixCode}
                            class="bg-surface-alt border border-ink-muted/20 text-ink px-3 py-2.5 text-xs md:text-sm flex-grow outline-none truncate font-mono"
                          />
                          <button
                            class="pix-copy-btn bg-surface border border-ink-muted/30 hover:border-accent text-ink px-4 py-2.5 text-xs md:text-sm font-bold uppercase transition-colors cursor-pointer"
                            data-pix={pixCode}
                          >
                            Copiar
                          </button>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>

    {/* CANCELADAS / EXPIRADAS (Eventos Futuros) */}
    {cancelledRegistrations.length > 0 && (
      <div>
        <h2 class="font-heading text-xl md:text-2xl font-bold uppercase text-ink tracking-wider mb-6 border-b border-ink-muted/20 pb-4">
          Inscrições Canceladas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 opacity-75 hover:opacity-100 transition-opacity duration-300">
          {cancelledRegistrations.map((reg) => {
            const statusConfig = getStatusClasses(reg.status, reg.paymentStatus, 'CANCELLED');

            return (
              <div class="bg-surface-alt border border-red-500/20 p-6 md:p-8 flex flex-col justify-between relative group grayscale hover:grayscale-0 transition-all duration-300 shadow-sm">
                <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-red-500/20 pointer-events-none group-hover:border-red-500/40 transition-colors"></div>

                <div>
                  <div class="flex items-center justify-between mb-4 font-mono text-xs md:text-sm">
                    <span class="text-ink-muted uppercase font-semibold">Inscrição #{reg.id.substring(0, 8).toUpperCase()}</span>
                    <span class={`flex items-center gap-1.5 px-3 py-1 text-xs font-semibold border ${statusConfig.bg}`}>
                      <span class={`w-2 h-2 rounded-full ${statusConfig.indicator}`}></span>
                      {statusConfig.label}
                    </span>
                  </div>

                  <h3 class="font-heading text-xl md:text-2xl font-bold text-ink-muted uppercase tracking-wider mb-3 line-through decoration-red-500/40">
                    {reg.event.title}
                  </h3>

                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-5 gap-x-6 my-6 font-mono text-sm">
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Data do Evento</span>
                      <span class="text-ink block mt-1 text-sm md:text-base">{formatDate(reg.event.date)}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Data Inscrição</span>
                      <span class="text-ink block mt-1 text-sm md:text-base">{formatDate(reg.createdAt)}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Valor</span>
                      <span class="text-ink font-bold block mt-1 text-base md:text-lg">{formatCurrency(Number(reg.amountPaid))}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Categoria</span>
                      <span class="text-ink block mt-1 text-sm md:text-base">{reg.category.name}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Lote Adquirido</span>
                      <span class="text-ink block mt-1 text-sm md:text-base">{reg.batch.name}</span>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    {/* ENCERRADAS (Histórico de Eventos) */}
    {pastRegistrations.length > 0 && (
      <div>
        <h2 class="font-heading text-xl md:text-2xl font-bold uppercase text-ink tracking-wider mb-6 border-b border-ink-muted/20 pb-4">
          Histórico de Eventos
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 opacity-75 hover:opacity-100 transition-opacity duration-300">
          {pastRegistrations.map((reg) => {
            const statusConfig = getStatusClasses(reg.status, reg.paymentStatus, 'PAST');

            return (
              <div class="bg-surface-alt border border-ink-muted/20 p-6 md:p-8 flex flex-col justify-between relative group grayscale hover:grayscale-0 transition-all duration-300 shadow-sm">
                <div class="absolute top-0 right-0 w-8 h-8 border-t border-r border-ink-muted/20 pointer-events-none group-hover:border-accent/40 transition-colors"></div>

                <div>
                  <div class="flex items-center justify-between mb-4 font-mono text-xs md:text-sm">
                    <span class="text-ink-muted uppercase font-semibold">Inscrição #{reg.id.substring(0, 8).toUpperCase()}</span>
                    <span class={`flex items-center gap-1.5 px-3 py-1 text-xs font-semibold border ${statusConfig.bg}`}>
                      <span class={`w-2 h-2 rounded-full ${statusConfig.indicator}`}></span>
                      {statusConfig.label}
                    </span>
                  </div>

                  <h3 class="font-heading text-xl md:text-2xl font-bold text-ink uppercase tracking-wider mb-3">
                    {reg.event.title}
                  </h3>

                  <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-5 gap-x-6 my-6 font-mono text-sm">
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Data do Evento</span>
                      <span class="text-ink font-bold block mt-1 text-sm md:text-base">{formatDate(reg.event.date)}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Data Inscrição</span>
                      <span class="text-ink font-medium block mt-1 text-sm md:text-base">{formatDate(reg.createdAt)}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Valor Pago</span>
                      <span class="text-ink font-bold block mt-1 text-base md:text-lg">{formatCurrency(Number(reg.amountPaid))}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Categoria</span>
                      <span class="text-ink font-medium block mt-1 text-sm md:text-base">{reg.category.name}</span>
                    </div>
                    <div>
                      <span class="text-ink-muted block uppercase text-xs font-semibold tracking-wider">Lote Adquirido</span>
                      <span class="text-ink font-medium block mt-1 text-sm md:text-base">{reg.batch.name}</span>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}
  </section>

  <!-- Toast Notificação Cópia -->
  <div
    id="copy-toast"
    class="fixed bottom-6 right-6 z-50 bg-surface-alt border border-emerald-500/50 p-4 font-mono text-xs text-emerald-600 dark:text-emerald-400 hidden shadow-2xl flex items-center gap-3"
  >
    <span class="w-2 h-2 bg-emerald-500 rounded-full inline-block"></span>
    Código PIX copiado com sucesso!
  </div>
</BaseLayout>

<script>
  // Script client-side para gerenciar a cópia do PIX
  const copyButtons = document.querySelectorAll('.pix-copy-btn');
  const toast = document.getElementById('copy-toast');

  if (copyButtons && toast) {
    copyButtons.forEach(button => {
      button.addEventListener('click', () => {
        const pixCode = button.getAttribute('data-pix');
        if (pixCode) {
          navigator.clipboard.writeText(pixCode);
          
          // Feedback Visual do Botão
          const prevText = (button as HTMLElement).innerText;
          (button as HTMLElement).innerText = 'Copiado!';
          
          // Exibir Toast
          toast.classList.remove('hidden');
          
          setTimeout(() => {
            (button as HTMLElement).innerText = prevText;
            toast.classList.add('hidden');
          }, 3000);
        }
      });
    });
  }
</script>
