# ========================================
# SyncFlow — Test Environment
# ========================================
# Usado EXCLUSIVAMENTE em testes. Todas as deps externas são mockadas.

# --- Database (Container local ou in-memory) ---
DATABASE_URL="postgresql://syncflow:syncflow_dev_2024@localhost:5492/syncflow_test"

# --- Redis (Local container) ---
UPSTASH_REDIS_URL="redis://localhost:6379"

# --- Clerk (Mocked) ---
CLERK_SECRET_KEY="sk_test_mock_key_for_testing"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_mock_key_for_testing"

# --- Asaas (Mocked) ---
ASAAS_API_KEY="$aact_mock_key_for_testing"
ASAAS_WEBHOOK_TOKEN="mock_webhook_token"
ASAAS_ENVIRONMENT="sandbox"

# --- Resend (Mocked) ---
RESEND_API_KEY="re_mock_key_for_testing"

# --- Application ---
NODE_ENV="test"
API_PORT=3333
API_URL="http://localhost:3333"
WEB_URL="http://localhost:4321"
